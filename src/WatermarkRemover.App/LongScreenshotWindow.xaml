<Window x:Class="WatermarkRemover.App.LongScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="长截图拼接"
        Width="480" Height="390"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown"
        Closing="OnWindowClosing">
    <Border Background="#F21E1E1E" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1"
            Padding="16,12">
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" BlurRadius="22" ShadowDepth="4" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="长截图拼接" Foreground="#FFEDEDED" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SizeText" Foreground="#8AFFFFFF" FontSize="11"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="关闭" HorizontalAlignment="Right" Padding="10,4"
                        Click="OnCancelClick"/>
            </Grid>

            <Border Grid.Row="1" Background="#FF111111" CornerRadius="6" Padding="4">
                <Image x:Name="PreviewImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <TextBlock Grid.Row="2" Text="先滚动目标窗口，再点「追加下一屏」；每次滚动不要超过一屏的 80%。"
                       Foreground="#8AFFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="StatusText" Foreground="#FF9AD8FF" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Padding="12,6" Margin="0,0,8,0" Click="OnCancelClick"/>
                    <Button x:Name="AppendButton" Content="追加下一屏" Padding="12,6"
                            Margin="0,0,8,0" Click="OnAppendClick"/>
                    <Button x:Name="FinishButton" Content="完成并保存" Padding="12,6"
                            Click="OnFinishClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
