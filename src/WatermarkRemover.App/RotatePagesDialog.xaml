<Window x:Class="WatermarkRemover.App.RotatePagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="780" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">
    <!--
        按页旋转：勾选任意页（全选 / 奇数页 / 偶数页），点「旋转」每次顺时针 90°，
        可连续点，最后「保存旋转」一次性写盘。取代原来只能整份 90/180/270 的批量摆正。
    -->
    <Border Margin="16" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
            CornerRadius="12" Padding="20">
        <StackPanel>
            <Grid MouseLeftButtonDown="OnTitleDragMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets"
                               FontSize="16" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="旋转页面" Margin="10,0,0,0"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button Grid.Column="2" Content="&#xE711;" Width="30" Height="30"
                        Style="{StaticResource CaptionButton}" FontSize="10"
                        Click="OnCancelClick" ToolTip="关闭"/>
            </Grid>

            <TextBlock x:Name="HintText" Margin="0,12,0,0" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

            <Grid Margin="0,12,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="全选" Style="{StaticResource GhostButton}"
                            Padding="10,4" Click="OnSelectAllClick"/>
                    <Button Content="奇数页" Style="{StaticResource GhostButton}"
                            Padding="10,4" Margin="6,0,0,0" Click="OnSelectOddClick"/>
                    <Button Content="偶数页" Style="{StaticResource GhostButton}"
                            Padding="10,4" Margin="6,0,0,0" Click="OnSelectEvenClick"/>
                    <Button Content="清空" Style="{StaticResource GhostButton}"
                            Padding="10,4" Margin="6,0,0,0" Click="OnClearClick"/>
                </StackPanel>
                <Button x:Name="RotateButton" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}" Padding="14,6"
                        Click="OnRotateClick" ToolTip="选中的页面顺时针旋转 90°（可连续点）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="旋转" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PagesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,0,10,10" VerticalContentAlignment="Top">
                                <StackPanel Width="104">
                                    <Border Width="100" Height="128" Background="#F3F4F5"
                                            BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <RotateTransform Angle="{Binding Angle}"/>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Border>
                                    <TextBlock Text="{Binding Caption}" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Margin="0,10,0,0">
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource GhostButton}"
                            IsCancel="True" Click="OnCancelClick"/>
                    <Button x:Name="ApplyButton" Content="保存旋转"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Click="OnApplyClick" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
