<Window x:Class="WatermarkRemover.App.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WatermarkRemover.App.Controls"
        Title="看图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#C8000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowKeyDown"
        Closing="OnWindowClosing">

    <Window.Resources>
        <!-- Rail tile: one image from the current folder, framed like the PDF page tiles. -->
        <DataTemplate x:Key="RailThumbTemplate">
            <Border Margin="0,0,0,8" Padding="3" CornerRadius="8"
                    BorderThickness="1" Cursor="Hand"
                    Tag="{Binding}" ToolTip="{Binding Name}"
                    MouseLeftButtonUp="OnRailThumbClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#2E000000"/>
                        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="#55407BC0"/>
                                <Setter Property="BorderBrush" Value="#B3407BC0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Source="{Binding Thumb}" Width="76" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Fullscreen screenshot viewer. Same shell as FullscreenViewerWindow (PDF pages):
         dark veil over the whole screen, film rail of the folder on the left, caption bar
         top-left, paging arrows on the canvas edges, close flush in the corner. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- film rail: every image in the folder, click one to switch -->
        <Border Grid.Column="0" Background="#66000000"
                BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="图片" FontSize="12"
                           Foreground="#99FFFFFF" Margin="2,0,0,10"/>

                <ScrollViewer x:Name="RailScroller" Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <ItemsControl x:Name="RailList"
                                  ItemTemplate="{StaticResource RailThumbTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,12,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="#E6FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Text="看图" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="320"/>
                    <TextBlock x:Name="PositionText" Text="" FontSize="12"
                               Foreground="#99FFFFFF" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InfoText" Text="" FontSize="11"
                               Foreground="#80FFFFFF" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="滚轮缩放 · 拖动平移 · 双击 100% · ← → 切换图片 · R 旋转 · M 标注"
                           FontSize="11" Foreground="#66FFFFFF"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,54,0">
                    <Button x:Name="MarkupButton" Content="标注" Style="{StaticResource SmallButton}"
                            Click="OnMarkupClick" Margin="0,0,8,0"
                            ToolTip="在图上标注/打码，保存为同目录副本，原图不动（M）"/>
                    <Button Content="旋转" Style="{StaticResource SmallButton}"
                            Click="OnRotateClick" Margin="0,0,8,0"
                            ToolTip="顺时针旋转 90°（R，Shift+R 反向）"/>
                    <Button Content="复制" Style="{StaticResource SmallButton}"
                            Click="OnCopyClick" Margin="0,0,8,0"
                            ToolTip="复制图片到剪贴板（Ctrl+C）"/>
                    <Button Content="文件夹" Style="{StaticResource SmallButton}"
                            Click="OnRevealClick"
                            ToolTip="在资源管理器中定位"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <controls:ImageSurface x:Name="Surface" ShowCheckerboard="True"
                                       ViewChanged="OnSurfaceChanged"/>

                <!-- 编辑态工具条（阶段 1：截图查看器接入 AnnotationEditCore）。深色皮肤与
                     截图遮罩一致；浮在画布顶部，退出标注时收起。草稿层/文字浮层由代码挂到
                     ImageSurface 的覆盖层挂载点上，与图片平面严格同矩形。 -->
                <Border x:Name="EditBar" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,14,0,0" Padding="10,8" CornerRadius="10"
                        Background="#D9202024" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <DockPanel>
                        <controls:AnnotationToolbar x:Name="Toolbar" Skin="Dark"
                                                    VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="EditStatusText" Foreground="#99FFFFFF" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="保存副本" Style="{StaticResource SmallButton}"
                                    Click="OnSaveCopyClick" Margin="0,0,6,0"
                                    ToolTip="标注烧进图片并另存副本，原图不动（Ctrl+S）"/>
                            <Button Content="完成" Style="{StaticResource SmallButton}"
                                    Click="OnExitEditClick" ToolTip="退出标注（Esc）"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 编辑态常驻提示：标注数 + 操作口径 -->
                <Border x:Name="EditHint" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,66" Padding="12,6" CornerRadius="8"
                        Background="#B31F1F24">
                    <TextBlock x:Name="EditHintText" FontSize="11" Foreground="#CCFFFFFF"/>
                </Border>

                <!-- paging arrows on the canvas edges, same discs as the PDF viewer -->
                <Button x:Name="PrevButton" Style="{StaticResource CanvasNavButton}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="12,0,0,0" Content="&#xE76B;"
                        Click="OnPrevClick" ToolTip="上一张（←）"/>
                <Button x:Name="NextButton" Style="{StaticResource CanvasNavButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0" Content="&#xE76C;"
                        Click="OnNextClick" ToolTip="下一张（→）"/>

                <Border x:Name="Toast" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,28" Padding="12,6" CornerRadius="8"
                        Background="#E6202024">
                    <TextBlock x:Name="ToastText" FontSize="12" Foreground="#FFF0F0F4"/>
                </Border>
            </Grid>

            <!-- Same corner target as the PDF viewer: pointer to the top-right, one click, gone. -->
            <Button Grid.Row="0" Grid.RowSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource VeilCloseButton}"
                    Content="&#xE711;"
                    Click="OnCloseClick"
                    ToolTip="关闭看图（Esc 同样生效）"/>
        </Grid>
    </Grid>
</Window>
