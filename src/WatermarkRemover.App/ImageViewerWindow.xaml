<Window x:Class="WatermarkRemover.App.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="看图"
        Width="960" Height="680"
        MinWidth="420" MinHeight="320"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF141417"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown"
        MouseWheel="OnWindowMouseWheel">
    <shell:WindowChrome.WindowChrome>
        <!-- A custom header replaces the title bar; 6px of invisible frame keeps edge resizing. -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Transparency checkerboard, the way every modern viewer shows an alpha channel. -->
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                      Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF1A1A1E">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF232329">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFD8D8DE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="Transparent" CornerRadius="6" Padding="9,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#E8D93030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="FooterRow" Height="26"/>
        </Grid.RowDefinitions>

        <!-- Header: drag area + viewer actions -->
        <Border x:Name="Header" Grid.Row="0" Background="#FF19191E"
                BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnHeaderMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="看图" FontSize="12.5"
                           Foreground="#FFF0F0F4" VerticalAlignment="Center"
                           Margin="12,0,12,0"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,6,0">
                    <Button Style="{StaticResource ChromeButton}" Content="适应窗口"
                            Click="OnFitClick" ToolTip="适应窗口（0）"/>
                    <Button Style="{StaticResource ChromeButton}" Content="100%"
                            Click="OnActualClick" ToolTip="原始像素（1）"/>
                    <Button Style="{StaticResource ChromeButton}" Content="旋转"
                            Click="OnRotateClick" ToolTip="顺时针旋转 90°（R，Shift+R 反向）"/>
                    <Button Style="{StaticResource ChromeButton}" Content="复制"
                            Click="OnCopyClick" ToolTip="复制图片到剪贴板（Ctrl+C）"/>
                    <Button Style="{StaticResource ChromeButton}" Content="文件夹"
                            Click="OnRevealClick" ToolTip="在资源管理器中定位"/>
                    <Button Style="{StaticResource ChromeButton}" Content="全屏"
                            Click="OnFullscreenClick" ToolTip="全屏（F11）"/>
                    <Button Style="{StaticResource CloseButton}" Content="✕"
                            Click="OnCloseClick" ToolTip="关闭（Esc）"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Viewport: checkerboard behind the photo, drag to pan, wheel to zoom -->
        <Grid x:Name="Viewport" Grid.Row="1" Background="{StaticResource CheckerBrush}"
              ClipToBounds="True"
              MouseLeftButtonDown="OnViewportMouseDown"
              MouseMove="OnViewportMouseMove"
              MouseLeftButtonUp="OnViewportMouseUp"
              MouseLeave="OnViewportMouseLeave"
              SizeChanged="OnViewportSizeChanged">
            <Image x:Name="Preview" Stretch="Fill"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True">
                <Image.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="Spin" Angle="0"/>
                        <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="Pan"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <TextBlock x:Name="StatusHint" Text="无法读取这张图片"
                       Foreground="#B8FFFFFF" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Footer: dimensions, size, zoom, position in the folder -->
        <Border Grid.Row="2" Background="#FF17171B" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="InfoText" FontSize="11" Foreground="#A8A8B2"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ZoomText" FontSize="11" Foreground="#A8A8B2"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
