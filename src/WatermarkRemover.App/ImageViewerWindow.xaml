<Window x:Class="WatermarkRemover.App.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WatermarkRemover.App.Controls"
        Title="看图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#C8000000"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowKeyDown">
    <!-- Fullscreen screenshot viewer. Deliberately the same shell as FullscreenViewerWindow
         (PDF pages): dark veil over the whole screen, caption bar top-left with title and
         position, hint in the middle, actions on the right, close flush in the corner.
         Only the content differs — here it is one image, there a PDF page. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,12,20,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="#E6FFFFFF" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="看图" FontSize="14" FontWeight="SemiBold"
                           Foreground="White" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="360"/>
                <TextBlock x:Name="PositionText" Text="" FontSize="12"
                           Foreground="#99FFFFFF" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="InfoText" Text="" FontSize="11"
                           Foreground="#80FFFFFF" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="滚轮缩放 · 拖动平移 · 双击 100% · ← → 切换图片 · R 旋转"
                       FontSize="11" Foreground="#66FFFFFF"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,54,0">
                <Button Content="旋转" Style="{StaticResource SmallButton}"
                        Click="OnRotateClick" Margin="0,0,8,0"
                        ToolTip="顺时针旋转 90°（R，Shift+R 反向）"/>
                <Button Content="复制" Style="{StaticResource SmallButton}"
                        Click="OnCopyClick" Margin="0,0,8,0"
                        ToolTip="复制图片到剪贴板（Ctrl+C）"/>
                <Button Content="文件夹" Style="{StaticResource SmallButton}"
                        Click="OnRevealClick"
                        ToolTip="在资源管理器中定位"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <controls:ImageSurface x:Name="Surface" ShowCheckerboard="True"
                                   ViewChanged="OnSurfaceChanged"/>

            <Border x:Name="Toast" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,28" Padding="12,6" CornerRadius="8"
                    Background="#E6202024">
                <TextBlock x:Name="ToastText" FontSize="12" Foreground="#FFF0F0F4"/>
            </Border>
        </Grid>

        <!-- Same corner target as the PDF viewer: pointer to the top-right, one click, gone. -->
        <Button Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Style="{StaticResource VeilCloseButton}"
                Content="&#xE711;"
                Click="OnCloseClick"
                ToolTip="关闭看图（Esc 同样生效）"/>
    </Grid>
</Window>
