<UserControl x:Class="WatermarkRemover.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="clr-namespace:WatermarkRemover.App"
             DataContextChanged="OnDataContextChanged"
             Background="Transparent">

    <!-- Layout mirrors the reference settings page: a gray left column (back / user card /
         search / nav) and a white right pane with inset gray cards. Colors come from the
         Shell* keys of Palette.xaml, sampled from the reference screenshots. -->

    <UserControl.Resources>
        <!-- Inset card: gray fill + hairline on the white pane -->
        <Style x:Key="InsetCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ShellInsetCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellInsetCardStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- Section heading above a card: dark, semibold -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>

        <!-- Row heading inside a card -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- Supporting text inside a card -->
        <Style x:Key="RowCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Hairline between card rows -->
        <Style x:Key="CardSeparator" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ShellInsetCardStrokeBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>

        <!-- "← 返回应用" row: full-width quiet row, light gray on hover -->
        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,6"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellMenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Left column: gray shell ================= -->
        <Border Grid.Column="0" Background="{StaticResource ShellSidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- window drag strip (caption height) -->
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back = save & exit; validation failures keep the page open -->
                <Button Grid.Row="1"
                        Style="{StaticResource BackButton}"
                        Click="OnBackClick"
                        ToolTip="保存设置并返回主界面">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="返回应用" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Grid.Row="2" Background="{StaticResource ShellInsetCardStrokeBrush}"/>

                <!-- User card -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,14,16,0">
                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{StaticResource AvatarBrush}">
                        <TextBlock Text="A" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="用户A" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Search: filters the nav rows by title + keywords -->
                <Border Grid.Row="4" Margin="12,12,12,10"
                        Background="{StaticResource ShellControlFillBrush}"
                        CornerRadius="8" Height="34" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Grid Grid.Column="1">
                            <TextBlock Text="搜索设置" FontSize="13"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="输入关键词筛选左侧设置栏目"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Navigation: registering a row in SettingsViewModel.NavItems adds a section -->
                <ListBox Grid.Row="5"
                         Margin="8,4,8,12"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" CornerRadius="8" Padding="12,9"
                                                Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background"
                                                        Value="{StaticResource ShellMenuHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background"
                                                        Value="{StaticResource ShellControlFillBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- nav search filter hides rows by collapsing the container -->
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Title}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ================= Right pane: white content ================= -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel Margin="36,54,36,48">

                    <!-- Page title follows the selected nav row -->
                    <TextBlock Text="{Binding SelectedNav.Title}"
                               FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,20"/>

                    <!-- ============ 通用设置 ============ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav.Id}" Value="general">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- 文件输出 -->
                        <TextBlock Text="文件输出" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="生成文件名后缀" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{Binding SuffixPreviewText}"
                                                   Style="{StaticResource RowCaption}"
                                                   Margin="0,3,16,0"/>
                                    </StackPanel>
                                    <TextBox x:Name="SuffixBox" Grid.Column="1"
                                             Width="200" Style="{StaticResource InputBox}"
                                             VerticalAlignment="Center"
                                             Text="{Binding Settings.OutputSuffix, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnSuffixTextChanged"/>
                                </Grid>

                                <Border Style="{StaticResource CardSeparator}"/>

                                <TextBlock Text="输出位置" Style="{StaticResource RowTitle}" Margin="0,0,0,8"/>
                                <RadioButton GroupName="OutputMode"
                                             Content="与源文件相同目录"
                                             FontSize="13" Margin="0,0,0,6"
                                             IsChecked="{Binding UseSameDirectory, Mode=TwoWay}"/>
                                <RadioButton GroupName="OutputMode"
                                             Content="指定目录"
                                             FontSize="13" Margin="0,0,0,8"
                                             IsChecked="{Binding UseCustomDirectory, Mode=TwoWay}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DirBox" Grid.Column="0"
                                             Style="{StaticResource InputBox}"
                                             IsEnabled="{Binding CustomDirEnabled}"
                                             Text="{Binding Settings.OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="浏览…"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmallButton}"
                                            Click="OnBrowseDirectory"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 常用文件名后缀 -->
                        <TextBlock Text="常用文件名后缀" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="处理完成后，点击文件名右侧的标签可把后缀快速加到文件名末尾，再点一次取消。标签顺序与任务列表中一致，可用上移、下移调整。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="0,0,0,10"/>
                                <ListBox Height="120" FontSize="13" BorderThickness="0"
                                         ItemsSource="{Binding QuickSuffixes}"
                                         SelectedIndex="{Binding SelectedSuffixIndex, Mode=TwoWay}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                             Text="{Binding NewSuffixText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10,6" KeyDown="OnSuffixBoxKeyDown"/>
                                    <Button Grid.Column="1" Content="添加"
                                            Style="{StaticResource SmallButton}"
                                            Margin="8,0,0,0"
                                            Command="{Binding AddSuffixCommand}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="上移" Style="{StaticResource SmallButton}" Command="{Binding MoveUpCommand}"/>
                                    <Button Content="下移" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding MoveDownCommand}"/>
                                    <Button Content="改为输入内容" Style="{StaticResource SmallButton}" Margin="16,0,0,0" Command="{Binding UpdateSuffixCommand}"/>
                                    <Button Content="删除" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DeleteSuffixCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 自动命名 -->
                        <TextBlock Text="自动命名" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <CheckBox Content="按文件内容自动命名去水印结果（如 林孝明执照）"
                                          IsChecked="{Binding Settings.AutoNameByContent}"
                                          FontSize="13"/>
                                <TextBlock Text="识别文件类型并提取客户姓名，生成「姓名＋类型」文件名；识别不出来时沿用上面的后缀规则。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="22,4,0,0"/>
                                <CheckBox Content="多页文件只识别第 1 页内容（识别更快，默认开）"
                                          IsChecked="{Binding Settings.NameFromFirstPageOnly}"
                                          FontSize="13"
                                          Margin="0,10,0,0"/>
                                <TextBlock Text="多页文件默认只用第 1 页命名，不逐页识别浪费时间；关闭后最多识别前 4 页，适合首页是封面或双面空白背面的文件。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="22,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 处理选项 -->
                        <TextBlock Text="处理选项" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <CheckBox Content="同时移除水印附带的链接注释"
                                          IsChecked="{Binding Settings.RemoveLinkedAnnotations}"
                                          FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="同时处理文件数：" FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <ComboBox Width="80" FontSize="13" Padding="8,6"
                                              SelectedIndex="{Binding ConcurrencyIndex}"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="4"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 扫描设置 ============ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav.Id}" Value="scan">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="扫描色彩" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="扫描输出的色彩模式，默认黑白（文字最锐利、文件最小、扫描最快）。改动随「返回应用」保存生效；扫描页只保留每次都要选的版面与开始按钮。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="0,0,0,12"/>
                                <RadioButton GroupName="SettingsScanColor" Tag="0"
                                             x:Name="ScanColorAutoBox"
                                             Content="自动" FontSize="13" Margin="0,0,0,8"
                                             ToolTip="引擎逐页判断彩色/灰度/黑白"
                                             VerticalContentAlignment="Center"
                                             Checked="OnScanColorChecked"/>
                                <RadioButton GroupName="SettingsScanColor" Tag="1"
                                             x:Name="ScanColorColorBox"
                                             Content="彩色" FontSize="13" Margin="0,0,0,8"
                                             ToolTip="保留原色，文件较大"
                                             VerticalContentAlignment="Center"
                                             Checked="OnScanColorChecked"/>
                                <RadioButton GroupName="SettingsScanColor" Tag="2"
                                             x:Name="ScanColorGrayBox"
                                             Content="灰度" FontSize="13" Margin="0,0,0,8"
                                             VerticalContentAlignment="Center"
                                             Checked="OnScanColorChecked"/>
                                <RadioButton GroupName="SettingsScanColor" Tag="3"
                                             x:Name="ScanColorBlackWhiteBox"
                                             Content="黑白" FontSize="13"
                                             ToolTip="文字最锐利、文件最小、扫描最快"
                                             VerticalContentAlignment="Center"
                                             Checked="OnScanColorChecked"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="输出目录" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="扫描完成的 PDF 保存到这里；留空则保存到系统的图片文件夹。目录不可用时自动回退图片文件夹，扫描永不因目录失败。改动随「返回应用」保存生效。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ScanDirBox" Grid.Column="0"
                                             Style="{StaticResource InputBox}"
                                             Text="{Binding Settings.ScanOutputDirectory, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                    <Button Grid.Column="1" Content="浏览…"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmallButton}"
                                            Click="OnBrowseScanDirectory"/>
                                    <Button Grid.Column="2" Content="恢复默认"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SmallButton}"
                                        ToolTip="清空目录，恢复保存到图片文件夹"
                                        Click="OnResetScanDirectory"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="手机传文件" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="手机上传的文件和链接自动转出的 PDF 保存到这里；留空则保存到桌面的「手机传文件」文件夹，目录不可用时自动回退。改动随「返回应用」保存生效，下次开始接收时启用新目录。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TransferDirBox" Grid.Column="0"
                                             Style="{StaticResource InputBox}"
                                             Text="{Binding Settings.TransferOutputDirectory, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                    <Button Grid.Column="1" Content="浏览…"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmallButton}"
                                            Click="OnBrowseTransferDirectory"/>
                                    <Button Grid.Column="2" Content="恢复默认"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmallButton}"
                                            ToolTip="清空目录，恢复保存到桌面的「手机传文件」文件夹"
                                            Click="OnResetTransferDirectory"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 网盘设置 ============ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav.Id}" Value="netdisk">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="网盘账号与授权" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="管理网盘产品账号与授权凭证。选择产品后填写对应密钥/令牌，可测试连接、完成 OAuth 授权。新增网盘产品后会自动出现在产品列表中。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="0,0,0,12"/>
                                <view:NetdiskAccountPanel DataContext="{Binding Netdisk}"/>
                                <Border Style="{StaticResource CardSeparator}"/>
                                <TextBlock Text="凭证仅保存在本机，敏感字段经 DPAPI 加密落盘；账号改动即时生效，不受「保存/取消」影响。"
                                           Style="{StaticResource RowCaption}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ OCR 识别 ============ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav.Id}" Value="ocr">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="版面识别" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="识别的第一步：怎么把页面切成区域。先识别版面、再逐区识别文字，可与下方的识别引擎自由组合（像搭积木一样搭配出一套解决方案）。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding LayoutOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton Grid.Column="0"
                                                                 GroupName="{Binding GroupName}"
                                                                 FontSize="13"
                                                                 VerticalContentAlignment="Center"
                                                                 IsEnabled="{Binding IsEnabled}"
                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 Content="{Binding Title}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource RowCaption}"
                                                           Margin="22,3,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="识别引擎" Style="{StaticResource SectionTitle}" Margin="16,16,0,8"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="识别的第二步：每个区域用哪个引擎读字。用于水印文字识别与「按内容自动命名」。默认按注册优先级自动选择可用引擎；指定某个引擎后保存立即生效，其不可用时自动回退。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding OcrOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton Grid.Column="0"
                                                                 GroupName="{Binding GroupName}"
                                                                 FontSize="13"
                                                                 VerticalContentAlignment="Center"
                                                                 IsEnabled="{Binding IsEnabled}"
                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 Content="{Binding Title}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource RowCaption}"
                                                           Margin="22,3,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 软件更新 ============ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav.Id}" Value="updates">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="版本与更新" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource InsetCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VersionText}"
                                               Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="更新包自动下载、校验，完成后重启生效。"
                                               Style="{StaticResource RowCaption}" Margin="0,3,0,0"/>
                                    <CheckBox Content="启动时自动检查更新"
                                              IsChecked="{Binding Settings.CheckUpdatesOnStartup}"
                                              FontSize="13" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Button x:Name="CheckUpdateButton" Grid.Column="1"
                                        Content="检查更新"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SmallButton}"
                                        Padding="14,8"
                                        Click="OnCheckUpdate"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ============ 日志与排障 ============ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav.Id}" Value="logs">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="执行日志" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="查看最近一段时间的执行记录，可导出后发回用于分析问题（如自动命名未生效）。日志仅保存在本机，保留 7 天。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="时间范围：" FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <ComboBox Width="110" FontSize="13" Padding="8,6"
                                              SelectedIndex="{Binding LogRangeIndex}"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="最近 1 小时"/>
                                        <ComboBoxItem Content="最近 24 小时"/>
                                        <ComboBoxItem Content="最近 7 天"/>
                                    </ComboBox>
                                    <TextBlock Text="{Binding LogStatusText}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                         Height="170" TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="{Binding LogPreviewText, Mode=OneWay}"
                                         Background="{StaticResource SurfaceBrush}"
                                         BorderBrush="{StaticResource ShellInsetCardStrokeBrush}"
                                         Padding="8,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="刷新" Style="{StaticResource SmallButton}" Command="{Binding RefreshLogCommand}"/>
                                    <Button Content="复制日志" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding CopyLogCommand}"/>
                                    <Button Content="导出日志文件…" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding ExportLogCommand}"/>
                                    <Button Content="打开日志文件夹" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding OpenLogFolderCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ 识别报告 ============ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav.Id}" Value="reports">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="识别报告" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="每次识别自动生成结构化报告：文档类型与得分、图片朝向、字段区域坐标（如经营者/名称出现位置）、姓名建议与复核问题。全量数据单独存于 reports 目录（JSONL，保留 90 天，可用于训练优化识别算法），日志中仅保留一行摘要。"
                                           Style="{StaticResource RowCaption}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ReportsStatusText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                         Height="170" TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="{Binding ReportsPreviewText, Mode=OneWay}"
                                         Background="{StaticResource SurfaceBrush}"
                                         BorderBrush="{StaticResource ShellInsetCardStrokeBrush}"
                                         Padding="8,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="刷新" Style="{StaticResource SmallButton}" Command="{Binding RefreshReportsCommand}"/>
                                    <Button Content="打开报告文件夹" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding OpenReportsFolderCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Save-on-exit affordance: leaving via the top saves, this discards -->
                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                        <Button Content="放弃更改"
                                Style="{StaticResource SmallButton}"
                                Padding="16,8"
                                Click="OnDiscardClick"
                                ToolTip="放弃本次修改并返回主界面"/>
                        <TextBlock Text="「返回应用」将自动保存全部更改"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
