<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:presentation="clr-namespace:WatermarkRemover.App.Presentation"
                    xmlns:vm="clr-namespace:WatermarkRemover.App.ViewModels">

    <!-- Shared control styles. Every window pulls these in via App.xaml; window-specific
         templates stay in the window. Colors always come from Palette.xaml keys. -->

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource AccentDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <!-- Primary button geometry with the destructive palette: the affirmative side of
             delete-style prompts -->
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource AccentDisabledBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small pill button used in settings sections -->
    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Flat caption buttons drawn by us (the system ones are gone with GlassFrameThickness=0) -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Floating round nav button on the inline preview canvas (image-viewer convention:
         translucent disc, white glyph, brightens on hover, dims when disabled). 46px so the
         paging / rotate / delete targets stay easy to find and hit on the dark canvas. -->
    <Style x:Key="CanvasNavButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Background" Value="#66202020"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="23">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#A6202020"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Copy-error pill shown on failed rows: puts the full diagnostic report on the clipboard -->
    <Style x:Key="RowCopyErrorButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Content" Value="复制报错"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Preview pill on finished rows: opens the in-app PDF preview overlay -->
    <Style x:Key="RowPreviewButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Content" Value="预览"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Compact per-row delete: quiet grey pill that turns red on hover — destructive affordance -->
    <Style x:Key="RowDeleteButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Content" Value="删除"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar bottom row (like a profile area): settings entry + version, separated by a line -->
    <Style x:Key="SidebarRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ShellMenuHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One PDF thumbnail tile, shared by both strip surfaces: the row-inline thumbnail grid
         under a job card and the film rail of the screen-level viewer. Single template, single
         click/rotate wiring — the two surfaces render the same view model collection anyway. -->
    <DataTemplate x:Key="PdfThumbnailTileTemplate">
        <!-- Width is per-tile (each page's own aspect — landscape pages grow wider); only the
             height is shared, so mixed portrait/landscape strips stay row-aligned. No margin
             here: the strip unit owns all spacing through its plus slots, so a plus sits
             exactly halfway between its neighbouring pages (a one-sided margin used to pull
             every plus off centre). -->
        <Grid Width="{Binding TileWidth}"
              Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <!-- click surface: opens the screen-level viewer on this page -->
            <Button Command="{Binding SelectCommand}"
                    ToolTip="点击放大该页"
                    Padding="0"
                    BorderThickness="0"
                    Focusable="False"
                    Cursor="Hand">
                <Grid>
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1">
                        <Image Source="{Binding Image}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="3"/>
                    </Border>
                    <!-- skeleton placeholder: the tile exists but its page pixels have not
                         arrived yet (a scan just landed, the strip fills tile by tile). A
                         shimmering sweep instead of a dead white card reads as "thumbnail
                         being generated" — the frontend skeleton-screen convention. The
                         layers stay Collapsed; DataTemplate.Triggers below reveal them. -->
                    <Border x:Name="SkeletonBase"
                            Margin="1"
                            Visibility="Collapsed"
                            Background="{StaticResource SurfaceAltBrush}"/>
                    <Grid ClipToBounds="True">
                        <Border x:Name="ShimmerStripe"
                                Width="70"
                                HorizontalAlignment="Left"
                                Margin="1"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <!-- Named on purpose: a template-declared Freezable is frozen for
                                     speed, and animating through a frozen instance is the
                                     "cannot animate (0).(1) on an immutable object" crash that
                                     killed the app mid-layout. A named instance stays mutable. -->
                                <TranslateTransform x:Name="ShimmerX" X="-70"/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#B3FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <Border Background="#99000000"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,4,4"
                            Padding="5,1"
                            CornerRadius="2">
                        <TextBlock Text="{Binding PageLabel}"
                                   FontSize="10"
                                   Foreground="White"/>
                    </Border>
                </Grid>
            </Button>

            <!-- accent ring on the page currently on screen -->
            <Border BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- corner edit buttons: rotate top-left, delete top-right; siblings above the
                 click surface so they win hit-testing on their own little area; both save
                 into the PDF at once -->
            <Button Panel.ZIndex="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="4,4,0,0"
                    Command="{Binding RotateCommand}"
                    ToolTip="顺时针旋转 90°，并立即保存到 PDF"
                    FontSize="12"
                    Padding="5,3"
                    Focusable="False">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Panel.ZIndex="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,4,0"
                    Command="{Binding DeleteCommand}"
                    ToolTipService.ShowOnDisabled="True"
                    FontSize="12"
                    Padding="5,3"
                    Focusable="False">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#C42B1C"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ToolTip" Value="删除该页，并立即保存到 PDF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                <Setter Property="ToolTip" Value="至少要保留一页，最后一页不可删除"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Skeleton switching lives here, in the TEMPLATE's trigger scope: a style's trigger
             storyboard cannot use TargetName (MC4011), and the sweep must reach the named
             unfrozen transform by name. -->
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                <Setter TargetName="SkeletonBase" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ShimmerStripe" Property="Visibility" Value="Visible"/>
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="TileShimmer">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ShimmerX"
                                             Storyboard.TargetProperty="X"
                                             From="-70" To="640" Duration="0:0:1.6"
                                             RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="TileShimmer"/>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One insert gap between two adjacent pages: a thin slot between two tiles. The slot
         itself is laid out from the first frame — a fixed 14px column the strip never
         reflows — but the plus GLYPH is revealed only while the pointer is over the slot:
         hidden until wanted, so it can never trail the thumbnails either. Hovering lights
         the slot and invites a single click — clicking it runs one scan and splices the
         fresh pages into the document right here. While such a pass IS holding the file, a
         hover shows the plus dimmed (not lit) and inert: the dead click can't be mistaken
         for a broken button. The same template serves the inline grid (wrap, horizontal)
         and the viewer rail (stack, vertical). -->
    <DataTemplate x:Key="PdfGapInsertTemplate">
        <!-- A narrow column between two pages is the hit zone: full tile height, plus
             centred — the user's mental model is "the plus sits before its page". 14px wide:
             the strip's whole spacing rhythm lives in this one slot (pages carry no margin),
             so the plus sits exactly halfway between its neighbours and the leading/trailing
             gaps match the page-to-page gap. -->
        <Button Width="14"
                Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                HorizontalAlignment="Center"
                Command="{Binding DataContext.InsertScanAfterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding InsertAfterIndex}"
                ToolTip="{Binding ToolTip}"
                Cursor="Hand"
                Focusable="False">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="Transparent" CornerRadius="3">
                                    <TextBlock x:Name="Glyph"
                                               Text="&#xE710;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellMenuHoverBrush}"/>
                                        <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <!-- A busy pass keeps the slot in place but hides the plus;
                                         hovering it shows the dimmed (0.3) glyph instead of the
                                         lit one — inert, so hover feedback never lies. -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Glyph" Property="Opacity" Value="0"/>
                                    </Trigger>
                                    <!-- Last so it overrides both triggers above when both are
                                         active (busy + hover): dim wins over lit and hidden. -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsEnabled" Value="False"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Root" Property="Background" Value="Transparent"/>
                                        <Setter TargetName="Glyph" Property="Opacity" Value="0.3"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </DataTemplate>

    <!-- One atomic strip unit: [left plus | page tile]. The wrap panel can only break BETWEEN
         units, so every row — including a wrapped second row — opens with its own plus slot
         and the columns stay vertically aligned.
         FLOW INVARIANT: every unit is exactly this wide (gap + tile), the last page included.
         The trailing "append after the last page" slot is a SEPARATE item after the units —
         never a third part of the last unit. Inside the unit it made that unit 14px wider than
         its siblings; a row with room for a tile but not for tile+14 then pushed the last page
         to the next row and left a cell-sized hole (2026-10-22 report). -->
    <DataTemplate x:Key="PdfStripUnitTemplate">
        <StackPanel Orientation="Horizontal">
            <ContentControl Content="{Binding Gap}"
                            ContentTemplate="{StaticResource PdfGapInsertTemplate}"/>
            <ContentControl Content="{Binding Tile}"
                            ContentTemplate="{StaticResource PdfThumbnailTileTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Units and the trailing gap item share one ItemsControl; this picks the right shape
         for each without widening the unit that carries the last page. -->
    <presentation:PdfStripItemTemplateSelector x:Key="PdfStripItemTemplateSelector"
                                               Unit="{StaticResource PdfStripUnitTemplate}"
                                               Gap="{StaticResource PdfGapInsertTemplate}"/>

    <!-- Hairline scrollbars, the way web apps do it: no arrow buttons, a thin rounded thumb
         floating in a narrow gutter instead of the fat Windows default. Every scroll bar in
         the app (record list, settings, preview rail) picks this up implicitly.
         Two traps live here, both bit us once: the thumb's visual must stretch ALONG the
         track (only the cross axis may be centred — centring both axes measures the visual
         to zero height and the bar renders nothing at all), and MinWidth/MinHeight must be
         zeroed or the theme's 17px floor wins and the gutter stops being hairline. -->
    <!-- Scrollers that must never shove their content sideways when the scrollbar appears:
         the vertical scrollbar gutter is RESERVED ALWAYS — "scrollbar-gutter: stable". Two
         surfaces need it. The inline thumbnail strip: zooming (draft-sized tiles vs the
         settled height cap) makes it overflow and un-overflow many times DURING one drag,
         and every Auto toggle stole/restored 10px of content width so the tiles trembled
         left-right. The record list: settling a zoom changes the row's height, the list's
         scrollbar toggles on that change, and the WHOLE window got shoved sideways (the
         "右侧滚动条出现导致抖动" report; the 140ms settle timer fires repeatedly during a
         slow drag). The bar itself stays Auto — hidden whenever content fits — and merely
         inherits the hairline style. -->
    <Style x:Key="StableGutterScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- Reserved whether or not the bar is showing. -->
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Margin="{TemplateBinding Padding}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Orientation="Vertical"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1"
                                   Orientation="Horizontal"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The record list (JobList) carries the same stable gutter. The default ListView
         template's internal ScrollViewer can't be reached directly, so this minimal template
         substitutes one styled with StableGutterScrollViewer; item visuals stay untouched in
         ItemContainerStyle. -->
    <Style x:Key="StableGutterListView" TargetType="ListView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Style="{StaticResource StableGutterScrollViewer}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <!-- Invisible paging buttons: the empty track above/below the
                                 thumb still pages, like every modern scroll bar. -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar"
                                                    Background="#FFC6CAD1"
                                                    CornerRadius="3"
                                                    Width="6"
                                                    HorizontalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#FF9AA1AB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track"
                                       Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="False"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False" Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Bar"
                                                            Background="#FFC6CAD1"
                                                            CornerRadius="3"
                                                            Height="6"
                                                            VerticalAlignment="Center"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="#FF9AA1AB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False" Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
