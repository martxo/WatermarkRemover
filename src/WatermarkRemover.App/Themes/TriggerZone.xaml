<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 触发区域样式：截图设置示意图里的热区块（ScreenshotTriggerEditor）。
         形状、颜色、阴影只在这一处定义，改样式只需改这一处。 -->

    <!-- 热区块：灰底示意图上偏透，不抢戏 -->
    <SolidColorBrush x:Key="TriggerCloudSoftFillBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="TriggerCloudEdgeBrush" Color="#99FFFFFF"/>

    <!-- 柔光阴影：零投影距离 + 大模糊，是热区块「浮起来」的唯一来源 -->
    <DropShadowEffect x:Key="TriggerCloudShadow" BlurRadius="16" ShadowDepth="0"
                      Color="#3D000000" Opacity="0.45"/>
</ResourceDictionary>
