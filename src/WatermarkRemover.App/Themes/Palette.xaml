<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semantic palette: the single source of truth for every color in the app.
         Windows must reference these keys instead of hard-coded hex values. -->

    <!-- Brand -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4F6EF7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF4058E0"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#FFB4BCE8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEEF1FE"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="PageBrush" Color="#FFF6F7F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF1F3F7"/>
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#FFEDF0F6"/>
    <SolidColorBrush x:Key="BorderBrushLight" Color="#FFE4E7ED"/>

    <!-- PDF preview: dark neutral canvas behind the white document pages -->
    <SolidColorBrush x:Key="PreviewCanvasBrush" Color="#FF33363D"/>

    <!-- Shell (sampled from the TRAE reference UI):
         outer window / sidebar / title bar are light gray, only the content card is white. -->
    <SolidColorBrush x:Key="ShellBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="ShellSidebarBrush" Color="#FFF3F4F5"/>
    <SolidColorBrush x:Key="ShellCardStrokeBrush" Color="#FFEEEEEE"/>
    <SolidColorBrush x:Key="ShellInsetCardBrush" Color="#FFF3F4F5"/>
    <SolidColorBrush x:Key="ShellInsetCardStrokeBrush" Color="#FFE4E8ED"/>
    <SolidColorBrush x:Key="ShellNavSelectedBrush" Color="#FFE5E5E5"/>
    <SolidColorBrush x:Key="ShellControlFillBrush" Color="#FFE1E4E7"/>
    <SolidColorBrush x:Key="ShellMenuHoverBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="AvatarBrush" Color="#FFA8DE63"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1D26"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6B7280"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF9AA1AC"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FFC4C9D4"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF10B981"/>
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#FFE7F8F1"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFEF4444"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFFDECEC"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFE81123"/>
</ResourceDictionary>
