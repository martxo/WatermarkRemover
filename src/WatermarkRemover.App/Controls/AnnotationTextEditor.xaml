<UserControl x:Class="WatermarkRemover.App.Controls.AnnotationTextEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Height="64"
             HorizontalAlignment="Left" VerticalAlignment="Top"
             Visibility="Collapsed">
    <!--
        文字标注浮层：截图遮罩与标注窗共用的输入框。
        Enter 提交、Shift+Enter 换行、Esc 取消、失焦提交——由控件统一收口，
        宿主只监听 Completed（null = 取消）并转交会话。
    -->
    <TextBox x:Name="Editor"
             Background="#F2FFFFFF" Foreground="#FFE53935" FontSize="16"
             BorderBrush="#FF3B82F6" BorderThickness="1" Padding="4,2"
             AcceptsReturn="True" TextWrapping="Wrap"
             VerticalContentAlignment="Top"
             VerticalScrollBarVisibility="Auto"
             ToolTip="Shift+Enter 换行，Enter 完成"
             KeyDown="OnEditorKeyDown" LostFocus="OnEditorLostFocus"/>
</UserControl>
