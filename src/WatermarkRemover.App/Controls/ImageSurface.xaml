<UserControl x:Class="WatermarkRemover.App.Controls.ImageSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Transparency checkerboard; it sits exactly behind the picture, never on the veil. -->
        <DrawingBrush x:Key="SurfaceCheckerBrush" TileMode="Tile"
                      Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF1A1A1E">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF232329">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <!-- One picture plane shared by every viewer (screenshots, PDF pages):
         wheel zooms around the cursor, drag pans, double click toggles fit <-> 100%.
         No chrome and no navigation — hosts own those. -->
    <Grid x:Name="Viewport" ClipToBounds="True"
          Background="Transparent"
          SizeChanged="OnViewportSizeChanged">
        <!-- 一个图片平面供所有看图器共用（截图、PDF 页）：滚轮以光标为锚缩放、拖动平移、
             双击适应/100%、可旋转视图。宿主拥有标题栏与翻页 chrome，只读回
             ZoomPercent / ModeName。

             重要：缩放/平移/旋转必须全部落在平面自身的布局尺寸与 Margin 上，不能用
             RenderTransform——部分机器的 WPF 渲染会把「比视口高的平面 + RenderTransform
             缩放」的底部整块裁掉（1718×1204 平面缩放 0.8412 后底部 161px 不绘制，
             本地探针复现并验证：改为布局尺寸后完整）。XAML 里不再有任何变换。 -->
        <Grid x:Name="Plane" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border x:Name="Checker" Background="{StaticResource SurfaceCheckerBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False"/>

            <Image x:Name="Preview" Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"/>
        </Grid>

        <TextBlock x:Name="StatusHint" Text="无法读取这张图片"
                   Foreground="#B8FFFFFF" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
