<Window x:Class="WatermarkRemover.App.BatchUprightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">
    <!--
        Batch upright for scan pages the per-page verdict left undecided. Direction and scope are
        chosen once and applied in a single save, so the user never has to rotate page by page.
    -->
    <Border Margin="16" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
            CornerRadius="12" Padding="20">
        <StackPanel>
            <Grid MouseLeftButtonDown="OnTitleDragMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets"
                               FontSize="16" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="批量摆正" Margin="10,0,0,0"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="&#xE711;" Width="30" Height="30"
                        Style="{StaticResource CaptionButton}" FontSize="10"
                        Click="OnCancelClick" ToolTip="关闭"/>
            </Grid>

            <TextBlock x:Name="MessageText" Margin="0,14,0,0" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="应用范围" Margin="0,16,0,6" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <RadioButton x:Name="ScopeAll" Content="整份文档（每一页都转）"
                         IsChecked="True" GroupName="Scope" FontSize="13"/>
            <RadioButton x:Name="ScopeUndecided" Content="仅未摆正的页"
                         GroupName="Scope" FontSize="13" Margin="0,6,0,0"/>

            <TextBlock Text="旋转方向" Margin="0,16,0,6" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Direction90" Content="顺时针 90°" IsChecked="True"
                             GroupName="Direction" FontSize="13" Margin="0,0,16,0"/>
                <RadioButton x:Name="Direction180" Content="180°"
                             GroupName="Direction" FontSize="13" Margin="0,0,16,0"/>
                <RadioButton x:Name="Direction270" Content="顺时针 270°"
                             GroupName="Direction" FontSize="13"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource GhostButton}"
                        IsCancel="True" Click="OnCancelClick"/>
                <Button Content="开始摆正" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="OnAcceptClick" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
