<UserControl x:Class="WatermarkRemover.App.PdfPreviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WatermarkRemover.App.Controls"
             xmlns:behaviors="clr-namespace:WatermarkRemover.App.Behaviors"
             Background="Transparent">

    <!-- Screen-level image viewer content (hosted by FullscreenViewerWindow, which paints the
         dark veil over the whole screen). The interaction is the desktop image-browser staple:
         a film-rail directory on the left, the page in the middle with wheel zoom anchored at
         the cursor, drag to pan, double click to fit, paging on the canvas edges. The shared
         strip drives both surfaces, so the rail is always in sync with the shown page. -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- film rail: the directory of pages, one tile per page, click to switch -->
        <Border Grid.Column="0"
                Background="#66000000"
                BorderBrush="#33FFFFFF"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="页面"
                           FontSize="12"
                           Foreground="#99FFFFFF"
                           Margin="2,0,0,10"/>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <ItemsControl ItemsSource="{Binding Thumbnails}"
                                  ItemTemplate="{StaticResource PdfThumbnailTileTemplate}"
                                  Visibility="{Binding HasThumbnails, Converter={StaticResource BoolToVis}}"
                                  behaviors:PdfPageDragReorder.IsEnabled="True"
                                  behaviors:PdfPageDragReorder.Orientation="Vertical">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- viewer column: caption bar, zoomable canvas, paging arrows -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- caption bar: file name + page indicator + actions, all on the veil -->
            <Grid Grid.Row="0" Margin="20,12,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A5;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="#E6FFFFFF"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding PageIndicator}"
                               FontSize="12"
                               Foreground="#99FFFFFF"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="滚轮缩放 · 拖动平移 · 双击 100% · 0 适应 · 1 原始 · +/- 缩放"
                           FontSize="11"
                           Foreground="#66FFFFFF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,54,0">
                    <!-- 页面缩放的可点入口：滚轮之外还有按钮，用户不必猜手势 -->
                    <Button Content="－" Style="{StaticResource SmallButton}"
                            Click="OnZoomOutClick" Margin="0,0,6,0"
                            ToolTip="缩小（-）"/>
                    <Button Content="＋" Style="{StaticResource SmallButton}"
                            Click="OnZoomInClick" Margin="0,0,6,0"
                            ToolTip="放大（+）"/>
                    <Button Content="适应" Style="{StaticResource SmallButton}"
                            Click="OnFitClick" Margin="0,0,6,0"
                            ToolTip="把整页放进窗口（0）"/>
                    <Button Content="1:1" Style="{StaticResource SmallButton}"
                            Click="OnActualSizeClick" Margin="0,0,10,0"
                            ToolTip="原始大小（1）"/>
                    <!-- 标注入口：进入后工具条浮出；保存默认「保留原文 + 叠加批注」 -->
                    <Button Content="{Binding AnnotationButtonText}"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding ToggleAnnotationCommand}" Margin="0,0,8,0"
                            ToolTip="在当前页上标注/打码；保存默认保留原文，文本仍可检索（M）"/>
                    <Button Content="插入文件"
                            Style="{StaticResource SmallButton}"
                            Click="OnInsertFileClick"
                            Margin="0,0,8,0"
                            ToolTip="选择另一个 PDF，把它的页插到当前页之后"/>
                    <Button Content="重新加载"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="重新渲染当前页（渲染失败时可重试）"/>
                </StackPanel>
            </Grid>

            <!-- page canvas: the shared ImageSurface does wheel zoom around the cursor,
                 drag pan and double-click 100% — the exact interaction the screenshot viewer
                 uses, so both fullscreen viewers behave the same. The page ops below stay. -->
            <Grid Grid.Row="1">
                <!-- 上下留白：整页「适应窗口」时页边不会贴着窗口边缘，看起来像被裁掉一截 -->
                <controls:ImageSurface x:Name="PageSurface"
                                       Source="{Binding CurrentImage}"
                                       AllowUpscaleInFit="True"
                                       Margin="0,6,0,14"/>

                <!-- 标注态（阶段 2）：工具条浮在画布顶部，深色皮肤与截图遮罩一致；草稿层/
                     文字浮层由代码挂到 PageSurface 的覆盖层挂载点上，与页面平面严格同矩形。
                     三档保存：保存批注=默认档（保留原文，可检索）/ 烧录定稿 / 导出。 -->
                <Border x:Name="EditBar" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,14,0,0" Padding="10,8" CornerRadius="10"
                        Background="#D9202024" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <DockPanel>
                        <controls:AnnotationToolbar x:Name="Toolbar" Skin="Dark"
                                                    VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding AnnotationStatusText}"
                                       Foreground="#99FFFFFF" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="保存批注" Style="{StaticResource SmallButton}"
                                    Command="{Binding SaveOverlayAnnotationsCommand}" Margin="0,0,6,0"
                                    ToolTip="档①：标注层叠回 PDF，原文与文本保留、可检索（Ctrl+S）"/>
                            <Button Content="烧录定稿" Style="{StaticResource SmallButton}"
                                    Command="{Binding BurnAnnotationsCommand}" Margin="0,0,6,0"
                                    ToolTip="档②：把标注烧进页面定稿，这些页之后不可检索、不可再改"/>
                            <Button Content="导出" Style="{StaticResource SmallButton}"
                                    Click="OnExportMenuClick" Margin="0,0,6,0"
                                    ToolTip="导出为图片型 PDF（彻底脱敏）或当前页 PNG">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="图片型 PDF（脱敏安全出口）"
                                                  Click="OnExportImagePdfClick"
                                                  ToolTip="整文档变成图片：黑块/马赛克底下的文字也一起消失，搜不出来、拷不出去"/>
                                        <MenuItem Header="当前页 PNG"
                                                  Click="OnExportPagePngClick"
                                                  ToolTip="把当前页（含标注）存成 PNG"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="完成" Style="{StaticResource SmallButton}"
                                    Click="OnExitAnnotationClick" ToolTip="退出标注（Esc）"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 标注态常驻提示：脏页数之外，固定说明视觉遮盖的边界 -->
                <Border x:Name="EditHint" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,66" Padding="12,6" CornerRadius="8"
                        Background="#B31F1F24">
                    <TextBlock x:Name="EditHintText" FontSize="11" Foreground="#CCFFFFFF"
                               Text="矩形/箭头/画笔/马赛克拖拽绘制 · 文字点击输入 · Ctrl+Z 撤销 · 翻页不丢标注 ·  Esc 退出。马赛克/黑块只防看不防取，彻底脱敏请用「导出 → 图片型 PDF」"/>
                </Border>

                <!-- corner edit buttons: rotate + delete side by side at top-left (mirroring the
                     tile layout), paging arrows on the canvas edges; they drive the current
                     page's tile commands, so rotate/delete here save into the PDF exactly like
                     the tiles do -->
                <Button Style="{StaticResource CanvasNavButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12,12,0,0"
                        Content="&#xE7AD;"
                        Command="{Binding CurrentTile.RotateCommand}"
                        IsEnabled="{Binding CurrentTile.CanRotate}"
                        ToolTip="顺时针旋转 90°，并立即保存到 PDF"/>
                <Button HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="66,12,0,0"
                        Content="&#xE74D;"
                        Command="{Binding CurrentTile.DeleteCommand}"
                        IsEnabled="{Binding CurrentTile.CanDelete}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="删除当前页，并立即保存到 PDF">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanvasNavButton}">
                            <Setter Property="Foreground" Value="#FF9A8F"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTile.CanDelete}" Value="False">
                                    <Setter Property="ToolTip" Value="至少要保留一页，最后一页不可删除"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Style="{StaticResource CanvasNavButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Content="&#xE76B;"
                        Command="{Binding PreviousCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        ToolTip="上一页"/>
                <Button Style="{StaticResource CanvasNavButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Content="&#xE76C;"
                        Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        ToolTip="下一页"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Width="180" Height="6"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="13"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>

            <!-- the close sits flush in the window's extreme top-right corner (spanning both
                 rows) — the desktop muscle-memory spot: slam the pointer into the corner,
                 click, and the viewer is gone. Same shared style as the screenshot viewer. -->
            <Button Grid.Row="0" Grid.RowSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource VeilCloseButton}"
                    Content="&#xE711;"
                    Command="{Binding CloseCommand}"
                    ToolTip="关闭看图（Esc 同样生效）"/>
        </Grid>
    </Grid>
</UserControl>
