<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WatermarkRemover.Core\WatermarkRemover.Core.csproj" />
    <!-- File index engine (快速搜索): NTFS/USN index, pipe client, install/update lifecycle. -->
    <ProjectReference Include="..\WatermarkRemover.Index\WatermarkRemover.Index.csproj" />
    <!-- Netdisk feature (网盘): product providers (Aliyun Drive first), discovered at runtime. -->
    <ProjectReference Include="..\WatermarkRemover.Netdisk\WatermarkRemover.Netdisk.csproj" />
    <ProjectReference Include="..\WatermarkRemover.Pdf\WatermarkRemover.Pdf.csproj" />
    <!-- Scan feature (扫描): engine channel (Brother bridge + WIA fallback) and PDF assembly. -->
    <ProjectReference Include="..\WatermarkRemover.Scan.Engine\WatermarkRemover.Scan.Engine.csproj" />
    <ProjectReference Include="..\WatermarkRemover.Scan.Pdf\WatermarkRemover.Scan.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF page rendering through pdfium: works where WinRT's Windows.Data.Pdf is missing
         (Windows N / LTSC / stripped systems), which surfaced as REGDB_E_CLASSNOTREG 0x80040154. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- PP-OCR (PaddleOCR ONNX) recognition for machines without WeChat. -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <!-- QR code for the 手机传文件 page: PngByteQRCode has no System.Drawing dependency. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <!-- Incremental updates (增量推送): vpk-generated delta/full packages on GitHub Releases.
         v1.2.158 was pulled for a severe bug — pin 1.2.161 or newer deliberately. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041 brings WinRT projections (Windows.Media.Ocr, Windows.Data.Pdf). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>WatermarkRemover</AssemblyName>
    <RootNamespace>WatermarkRemover.App</RootNamespace>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <Version>1.16.29</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Product>Watermark Remover</Product>
    <Company>WatermarkRemover</Company>
  </PropertyGroup>

  <!-- DEPLOY LAYOUT MANIFEST — the contract verified by VerifyPublishLayout below.
       Every file that must sit beside the exe is listed here with its intended location. When a
       feature needs a new sidecar asset, add its copy item below AND its expected path here; the
       publish gate then fails loudly instead of shipping a broken layout. -->
  <ItemGroup>
    <SidecarAsset Include="wcocr.dll" />
    <!-- Privileged index host for 快速搜索. Published by PublishFileIndexer below; the app copies
         it to ProgramData once, so the logon task never points into the versioned app folder. -->
    <SidecarAsset Include="WatermarkRemover.Indexer.exe" />
    <SidecarAsset Include="Models\ch_PP-OCRv5_det_mobile.onnx" />
    <SidecarAsset Include="Models\ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx" />
    <SidecarAsset Include="Models\ch_PP-OCRv5_rec_mobile.onnx" />
    <SidecarAsset Include="Models\ppocrv5_dict.txt" />
    <!-- Layout blocks (积木式识别管线). Sources verified on hf-mirror, Apache-2.0:
         wybxc/DocLayout-YOLO-DocStructBench-onnx — 75,324,598 bytes,
           sha256 FECE9AF02F618B603FF7921CCEC6861D13E7E1F9830E091DFB7E8AD9311E5B21
         stefanj0/PP-DocLayout-S-ONNX — 4,917,852 bytes,
           sha256 33688DBEE1C23E34B81777E97CB428EB40F24B242C02B5F623484959E830AEC8 -->
    <SidecarAsset Include="Models\doclayout_yolo_docstructbench_imgsz1024.onnx" />
    <SidecarAsset Include="Models\pp_doclayout_s.onnx" />
    <!-- Scan feature (扫描): x86 bridge into Brother's official engine. ScanCoreApi.dll ships as
         32-bit only, so the bridge is a separate self-contained x86 exe in its own folder beside
         the x64 app; published by PublishBrotherBridge below. -->
    <SidecarAsset Include="BrotherEngine\WatermarkRemover.Scan.Bridge.exe" />
  </ItemGroup>

  <!-- wcocr shim (github.com/swigger/wechat-ocr, x64 prebuilt): drives WeChat's offline OCR.
       ExcludeFromSingleFile keeps it beside the exe; bundled inside, P/Invoke probing depends on
       the runtime extraction directory and breaks silently. -->
  <ItemGroup>
    <None Include="Native\wcocr.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true">
      <Link>wcocr.dll</Link>
    </None>
  </ItemGroup>

  <!-- PP-OCRv5 mobile Chinese model set (det + cls + rec + dict, ~21.5 MB, RapidAI/PaddleOCR,
       Apache-2.0). Kept next to the exe — not inside the single-file bundle — so a model file can
       be replaced without rebuilding, and the updater can refresh it alongside the executable.
       ExcludeFromSingleFile is required: without it the bundler pulls content files into the exe. -->
  <ItemGroup>
    <None Update="Models\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- ONNX Runtime's package publishes its import-library files (*.lib); nothing links against
       them at runtime — keep the shipped package free of dev artifacts. -->
  <Target Name="DropDevArtifactsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <DevArtifacts Include="$(PublishDir)*.lib" />
    </ItemGroup>
    <Delete Files="@(DevArtifacts)" />
  </Target>

  <!-- RapidOcrNet's package targets copy its bundled PP-OCRv5 *latin* models into models\v5\ next
       to the binary; this app uses its own Chinese set in Models\ (PpOcrEngine passes explicit
       paths), so drop the unused latin bundle to keep the shipped payload lean. On Windows
       models\v5 resolves to the same directory as Models\v5 — delete only that subdirectory, the
       Chinese set lives directly in Models\. -->
  <Target Name="DropBundledLatinModelsBuild" AfterTargets="CopyModelsBuild">
    <RemoveDir Directories="$(TargetDir)Models\v5" />
  </Target>

  <Target Name="DropBundledLatinModelsPublish" AfterTargets="CopyModelsPublish">
    <RemoveDir Directories="$(PublishDir)Models\v5" />
  </Target>

  <!-- Brother x86 bridge publish: ScanCoreApi.dll is 32-bit only, so the bridge is a separate
       self-contained x86 exe. Published once into obj\BridgePublish, then copied into the
       BrotherEngine\ folder beside the app — both the publish tree (shipped) and the build tree
       (local probes). Runs before the layout gate so a missing bridge fails the build. -->
  <Target Name="PublishBrotherBridge" BeforeTargets="VerifyPublishLayout">
    <PropertyGroup>
      <_BridgeProject>..\WatermarkRemover.Scan.Bridge\WatermarkRemover.Scan.Bridge.csproj</_BridgeProject>
      <_BridgePublishDir>$(MSBuildThisFileDirectory)$(IntermediateOutputPath)BridgePublish\</_BridgePublishDir>
    </PropertyGroup>
    <MSBuild Projects="$(_BridgeProject)" Targets="Restore"
             Properties="RuntimeIdentifier=win-x86;SelfContained=true" />
    <MSBuild Projects="$(_BridgeProject)" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x86;SelfContained=true;PublishSingleFile=true;PublishDir=$(_BridgePublishDir)" />
    <ItemGroup>
      <_BridgeExe Include="$(_BridgePublishDir)WatermarkRemover.Scan.Bridge.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_BridgeExe)" DestinationFolder="$(PublishDir)BrotherEngine\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_BridgeExe)" DestinationFolder="$(TargetDir)BrotherEngine\" SkipUnchangedFiles="true" />
  </Target>

  <!-- Index host publish (快速搜索): a separate self-contained single-file exe. It must run as an
       elevated logon task on its own, so it cannot share the app's bundle. Published once into
       obj\IndexerPublish, then copied beside the app (publish tree + build tree).
       The sidecar keeps its OWN version on purpose: stamping it with the app version made every
       app release look like an engine update, so the search page kept offering a UAC prompt for
       an engine that had not changed. Bump WatermarkRemover.Indexer.csproj only when the host
       itself changes. -->
  <Target Name="PublishFileIndexer" BeforeTargets="VerifyPublishLayout">
    <PropertyGroup>
      <_IndexerProject>..\WatermarkRemover.Indexer\WatermarkRemover.Indexer.csproj</_IndexerProject>
      <_IndexerPublishDir>$(MSBuildThisFileDirectory)$(IntermediateOutputPath)IndexerPublish\</_IndexerPublishDir>
    </PropertyGroup>
    <MSBuild Projects="$(_IndexerProject)" Targets="Restore"
             Properties="RuntimeIdentifier=win-x64;SelfContained=true" />
    <MSBuild Projects="$(_IndexerProject)" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishDir=$(_IndexerPublishDir)" />
    <ItemGroup>
      <_IndexerExe Include="$(_IndexerPublishDir)WatermarkRemover.Indexer.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_IndexerExe)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_IndexerExe)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- PUBLISH GATE — turns "asset missing on the user's machine" (a runtime failure discovered on
       some other PC) into a build failure here. Runs last, after every drop/cleanup target:
       1. every SidecarAsset in the manifest exists next to the exe,
       2. dev artifacts (*.lib) did not leak into the publish directory.
       The manifest itself is what keeps assets out of the single-file bundle: each sidecar carries
       ExcludeFromSingleFile, and a missing file here means that rule was lost.
       Bypass with: dotnet publish -p:SkipPublishLayoutCheck=true -->
  <Target Name="VerifyPublishLayout" AfterTargets="Publish" Condition="'$(SkipPublishLayoutCheck)' != 'true'">
    <ItemGroup>
      <_MissingAsset Include="@(SidecarAsset)" Condition="!Exists('$(PublishDir)%(Identity)')" />
      <_LeakedArtifact Include="$(PublishDir)*.lib" />
    </ItemGroup>

    <Error Condition="'@(_MissingAsset)' != ''"
           Text="发布布局校验失败：缺少旁挂资源 $(PublishDir)@(_MissingAsset)。请检查 csproj 的 SidecarAsset 清单与对应复制项。" />

    <Error Condition="'@(_LeakedArtifact)' != ''"
           Text="发布布局校验失败：开发文件泄露进发布目录 @(_LeakedArtifact)。" />

    <Message Importance="high" Text="发布布局校验通过：@(SidecarAsset->Count()) 个旁挂资源就位，无开发文件泄露。" />
  </Target>

  <!-- Single-file, self-contained publish: run on any Windows machine with no install.
       ReadyToRun is deliberately OFF: PDFsharp 6.5's AGPL licence check inspects the calling
       assembly, and R2R pre-JITting breaks that probe ("Initialize has to be called from the
       PDFsharp assembly") only in the shipped build — debug runs and tests pass. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

</Project>
