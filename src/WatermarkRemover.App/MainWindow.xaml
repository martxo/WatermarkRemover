<Window x:Class="WatermarkRemover.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WatermarkRemover.App.Behaviors"
        xmlns:vm="clr-namespace:WatermarkRemover.App.ViewModels"
        Title="去水印工具"
        Width="960" Height="680"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FFF6F7F9"
        AllowDrop="True"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        Deactivated="OnWindowDeactivated"
        Drop="OnDrop"
        DragOver="OnDragOver">

    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4F6EF7"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEEF1FE"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#FFE4E7ED"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1D26"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF10B981"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FFEF4444"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF4058E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FFB4BCE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource BorderBrushLight}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared chip template: used by the inline row and by the expanded wrap row below the name -->
        <DataTemplate DataType="{x:Type vm:SuffixChipViewModel}">
            <Button Content="{Binding Label}"
                    Command="{Binding DataContext.ToggleSuffixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Cursor="Hand"
                    Margin="4,0,0,0"
                    ToolTip="点击把该后缀加到文件名末尾；再次点击取消">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFF1F3F7"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="12"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0">
                    <TextBlock Text="◆" FontSize="18" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="去水印工具" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="右下角角标水印 · PDF" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Content="设置"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnSettingsClick"/>
        </Grid>

        <!-- Drop zone -->
        <Border Grid.Row="1"
                x:Name="DropZone"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="14"
                Margin="0,0,0,16"
                Padding="28">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📄" FontSize="34" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DropHintText"
                           Text="把 PDF 文件拖到这里，松手即开始去水印"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
                <TextBlock Text="支持多个文件同时拖入 · 处理完成后保存在下方设置的目录"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="选择文件…" Style="{StaticResource PrimaryButton}" Click="OnPickFiles"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- File list -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="EmptyStateText"
                           Text="暂无文件 · 拖入或点击「选择文件」开始"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,30"/>

                <ListView Grid.Row="1"
                          x:Name="JobList"
                          ItemsSource="{Binding Jobs}"
                          Visibility="Collapsed"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <!-- Name row: the file name takes the remaining width, quick-suffix chips
                                             sit to its right. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- file name: click to edit inline, click away/Enter saves, Esc cancels.
                                                 Hover shows a subtle pill background — the standard "this is editable" affordance. -->
                                            <Grid Grid.Column="0">
                                                <Border CornerRadius="6" Padding="4,2"
                                                        ToolTip="{Binding HeaderToolTip}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- Background must live in the Style: a local value on the element
                                                                 would outrank the hover trigger and the effect would never show. -->
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FFEDF0F6"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Cursor="Hand">
                                                        <TextBlock.InputBindings>
                                                            <MouseBinding Gesture="LeftClick" Command="{Binding BeginEditCommand}"/>
                                                        </TextBlock.InputBindings>
                                                    </TextBlock>
                                                </Border>

                                                <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" FontWeight="SemiBold"
                                                         Padding="6,2"
                                                         VerticalContentAlignment="Center"
                                                         LostFocus="OnRenameBoxLostFocus"
                                                         KeyDown="OnRenameBoxKeyDown"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                         behaviors:FocusWhenVisible.Enabled="True">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Background" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRenamable}" Value="False">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>

                                            <!-- Quick suffix chips — a dropdown component: sits right of the name; the
                                                 toggle opens an overlay with the overflow suffixes that floats above
                                                 the card, so the card layout never changes. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0"
                                                        Visibility="{Binding ChipsVisible, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding InlineChips}"
                                                          VerticalAlignment="Center"
                                                          Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <!-- Chevron toggle: always in place, flips between ▾ / ▴ to reflect state —
                                                 part of the chip family, never jumps. -->
                                            <Button Command="{Binding ToggleSuffixDropdownCommand}"
                                                    Cursor="Hand"
                                                    Margin="2,0,0,0"
                                                    ToolTip="展开或收起更多常用后缀"
                                                    Visibility="{Binding HasMoreChips, Converter={StaticResource BoolToVis}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#FFF1F3F7"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Setter Property="Content" Value="▾"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="Padding" Value="7,4"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="12"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSuffixDropdownOpen}" Value="True">
                                                                <Setter Property="Content" Value="▴"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Seamless expansion: the overlay is pure card-white with no border, shadow
                                                 or corners — on the white card it is invisible, so the overflow chips
                                                 simply read as the same pill group continuing on a wrapped second line
                                                 (the white surface only masks the path row underneath). -->
                                            <Popup IsOpen="{Binding IsSuffixDropdownOpen}"
                                                   StaysOpen="False"
                                                   Placement="Bottom"
                                                   PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                   VerticalOffset="5"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade">
                                                <Border Background="White"
                                                        Padding="2,2,6,6"
                                                        MaxWidth="420">
                                                    <ItemsControl ItemsSource="{Binding OverflowChips}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>
                                            </StackPanel>
                                        </Grid>

                                        <!-- path row: click the path to open its folder; time at the right -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Detail}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="ToolTip" Value="点击打开文件所在位置"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OutputPath}" Value="{x:Null}">
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                                <Setter Property="ToolTip" Value="{x:Null}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding OutputPath}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProcessedAtText}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       ToolTip="{Binding ProcessedAt, TargetNullValue=处理完成时间}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- status chip -->
                                        <Border CornerRadius="20" Padding="12,5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF1F3F7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                                            <Setter Property="Background" Value="#FFE7F8F1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                            <Setter Property="Background" Value="#FFFDECEC"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Processing">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Processing">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <Button Content="清空列表"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    Command="{Binding ClearCommand}"/>
        </Grid>
    </Grid>
</Window>
