<Window x:Class="WatermarkRemover.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WatermarkRemover.App.Behaviors"
        xmlns:vm="clr-namespace:WatermarkRemover.App.ViewModels"
        xmlns:presentation="clr-namespace:WatermarkRemover.App.Presentation"
        xmlns:app="clr-namespace:WatermarkRemover.App"
        Title="办公助理"
        Width="960" Height="760"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBrush}"
        AllowDrop="True"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        Deactivated="OnWindowDeactivated"
        Drop="OnDrop"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        StateChanged="OnWindowStateChanged">
    <WindowChrome.WindowChrome>
        <!-- Flat, integrated title bar: the top 44px belongs to our layout (brand on the left),
             while the system caption buttons stay for snap/min/max/close. -->
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Palette and shared control styles live in Themes/ (merged in App.xaml).
             Only window-specific templates stay here. -->

        <!-- ===== Feature pages: ViewLocator targets =====
             The shell renders SelectedFeature through FeaturePageSelector, which picks one
             of these templates from the feature's declared PageKind. No feature id, and no
             per-feature DataTrigger, appears anywhere in this window. -->
        <DataTemplate x:Key="Page.Files">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <!-- Drop zone: three-state interaction modelled after mainstream upload components
             (Ant Design Dragger / react-dropzone). Idle = white fill + dashed neutral outline;
             accept = accent tint + solid accent outline fading in over 150ms with the icon
             scaling up; reject = red tint/outline + cancel glyph. All driven by DropZoneState
             bindings — code-behind never touches this visual tree. -->
        <!-- Border has no ControlTemplate of its own, so the layered shell/tint/outline that
             carries the three-state visuals lives in a ContentControl template instead. -->
        <ContentControl
                Margin="0,0,0,16"
                Padding="28"
                Focusable="False"
                IsTabStop="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <Grid>
                                    <!-- Idle shell: white fill, dashed neutral outline -->
                                    <Rectangle x:Name="IdleShell"
                                               RadiusX="14" RadiusY="14"
                                               Fill="White"
                                               Stroke="{StaticResource BorderBrushLight}"
                                               StrokeThickness="2"
                                               StrokeDashArray="7 5"/>
                                    <!-- State tint: fades in on accept/reject (color swaps in
                                         instantly while opacity is still 0, so no flash) -->
                                    <Rectangle x:Name="StateTint"
                                               RadiusX="14" RadiusY="14"
                                               Fill="{StaticResource AccentSoftBrush}"
                                               Opacity="0"/>
                                    <!-- State outline: solid line fading in over the dashes -->
                                    <Rectangle x:Name="StateOutline"
                                               RadiusX="14" RadiusY="14"
                                               Stroke="{StaticResource AccentBrush}"
                                               StrokeThickness="2"
                                               Opacity="0"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DropZoneState}" Value="Accept">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="StateTint"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="StateOutline"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="StateTint"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="StateOutline"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DropZoneState}" Value="Reject">
                                        <Setter TargetName="StateTint" Property="Fill" Value="{StaticResource DangerSurfaceBrush}"/>
                                        <Setter TargetName="StateOutline" Property="Stroke" Value="{StaticResource DangerBrush}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="StateTint"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="StateOutline"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="StateTint"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="StateOutline"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContentControl.Style>
            <StackPanel HorizontalAlignment="Center">
                <!-- Upload glyph scales up while files hover (react-dropzone style) and flips
                     to the cancel glyph with a red tint when the payload is rejected. -->
                <TextBlock Text="{Binding DropZoneIcon}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="34"
                           HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DropZoneState}" Value="Accept">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                 To="1.15" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                 To="1.15" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DropZoneState}" Value="Reject">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DropHint}"
                           FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DropZoneState}" Value="Reject">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="在左侧选择功能 · 支持多个文件同时拖入 · 完成后保存在下方设置的目录"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="选择文件…" Style="{StaticResource PrimaryButton}" Click="OnPickFiles"/>
                </StackPanel>
            </StackPanel>
        </ContentControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Page.Scan">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <!-- Scan panel (扫描): layout choice + scan button. Files come from the scanner. -->
        <Border Margin="0,0,0,16" Style="{StaticResource CardBorder}" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="扫描版面"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>
                <RadioButton GroupName="ScanDuplex"
                             Content="单面" Margin="0,0,18,0"
                             VerticalContentAlignment="Center"
                             IsChecked="{Binding IsScanSimplex, Mode=TwoWay}"/>
                <RadioButton GroupName="ScanDuplex"
                             Content="双面长边" Margin="0,0,18,0"
                             VerticalContentAlignment="Center"
                             IsChecked="{Binding IsScanDuplexLongEdge, Mode=TwoWay}"/>
                <RadioButton GroupName="ScanDuplex"
                             Content="双面短边" Margin="0,0,0,0"
                             VerticalContentAlignment="Center"
                             IsChecked="{Binding IsScanDuplexShortEdge, Mode=TwoWay}"/>
                <Button Content="开始扫描"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanCommand}"
                        MinWidth="110" Margin="16,0,0,0"/>
                <Button Content="取消扫描"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding CancelScanCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Page.Search">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <!-- Quick search panel (快速搜索): built-in NTFS index, full page height. -->
        <Border Margin="0,0,0,16" Style="{StaticResource CardBorder}">
            <Grid Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Query row: Enter searches immediately, typing searches after a short pause. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Style="{StaticResource InputBox}"
                                 Padding="34,8,10,8"
                                 FontSize="14"
                                 Text="{Binding Search.SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Search.SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <Button Grid.Column="1"
                            Content="搜索"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding Search.SearchCommand}"
                            MinWidth="90" Margin="12,0,0,0"/>
                </Grid>

                <!-- Status + setup button when the index engine is absent or needs updating. -->
                <Grid Grid.Row="1" Margin="0,10,0,8">
                    <TextBlock Text="{Binding Search.StatusText}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="{Binding Search.InstallButtonText}"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding Search.InstallProviderCommand}"
                            HorizontalAlignment="Right"
                            Visibility="{Binding Search.ShowInstallButton, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Hits: double-click opens, single click selects for the action row below. -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Search.Results}"
                         SelectedItem="{Binding Search.SelectedResult, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" CornerRadius="8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#F5F6F8"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,9">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCommand}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Directory}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeText}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ModifiedText}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="打开"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding Search.OpenCommand}"
                            MinWidth="90"/>
                    <Button Content="打开所在文件夹"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding Search.OpenFolderCommand}"
                            Margin="10,0,0,0"/>
                    <Button Content="复制路径"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding Search.CopyPathCommand}"
                            Margin="10,0,0,0"/>
                    <Button Content="删除"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding Search.DeleteCommand}"
                            Foreground="{StaticResource DangerBrush}"
                            ToolTip="移到回收站（可还原）"
                            Margin="10,0,0,0"/>
                    <TextBlock Text="双击结果也可直接打开"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
            </Grid>
        </DataTemplate>

<DataTemplate x:Key="Page.Netdisk">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <!-- Netdisk panel (网盘): entry hub — open the management window or quick-upload. Replaces
             the drop zone on the netdisk page (which hides itself via its style trigger). -->
        <Border Margin="0,0,0,16" Style="{StaticResource CardBorder}">
            <StackPanel Margin="20,16">
                <TextBlock Text="网盘"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="管理已接入的网盘产品（阿里云盘等）：浏览、上传、下载、删除。账号与 API 密钥在「设置 → 网盘设置」中配置。"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="打开网盘管理"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding Netdisk.OpenCommand}"
                            MinWidth="120"/>
                    <Button Content="快速上传…"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding Netdisk.QuickUploadCommand}"
                            Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Netdisk.SummaryText}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Page.Transfer">
            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <!-- Transfer panel (手机传文件): QR code + start/stop. Replaces the drop zone on the
             transfer page (which hides itself via its style trigger). -->
        <Border Margin="0,0,0,16" Style="{StaticResource CardBorder}">
            <Grid Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: QR card, action buttons and status underneath; the how-to text
                     lives in a hover tip so the right column stays entirely for the message log. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top" Width="150">
                    <Border Width="150" Height="150" CornerRadius="10" Background="White"
                            BorderBrush="{StaticResource ShellCardStrokeBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding Transfer.QrImage}" Stretch="Uniform" Margin="6"/>
                            <TextBlock Text="点击「开始接收」&#x0A;生成二维码"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Transfer.IsRunning}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Button Content="{Binding Transfer.ToggleText}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding Transfer.ToggleCommand}"
                            Margin="0,12,0,0"/>
                    <Button Content="打开文件夹"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding Transfer.OpenFolderCommand}"
                            Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Transfer.StatusText}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <TextBlock HorizontalAlignment="Left" Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Cursor="Hand"
                               ToolTipService.InitialShowDelay="150"
                               ToolTipService.Placement="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="ⓘ 使用说明"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Transfer.IsRunning}" Value="True">
                                        <Setter Property="Text" Value="ⓘ 使用说明 / 地址"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="320">
                                    <TextBlock Text="手机与电脑连接同一 Wi-Fi，用相机或微信扫一扫二维码，在浏览器里选择文件或发送文本即可传到电脑。文件仅在局域网内直传，不经过任何服务器。"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Transfer.UrlText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Transfer.IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </StackPanel>

                <!-- Right column: the message log, full height of the panel. The panel's height
                     is pinned by the left column, so the file list below never gets squeezed. -->
                <Border Grid.Column="1"
                        Margin="18,0,0,0"
                        Background="#FAFBFC"
                        BorderBrush="{StaticResource ShellCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <!-- Empty state: a quiet hint while no text has arrived yet. -->
                        <TextBlock Text="发送记录&#x0A;手机发送的文本将显示在这里，点击条目右侧「复制」可重新复制全文"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" FontSize="12" LineHeight="20"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Transfer.HasMessages}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Transfer.HasMessages}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding Transfer.Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F5F6F8"
                                                CornerRadius="6"
                                                Padding="10,7"
                                                Margin="0,0,0,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TimeText}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Sender}"
                                                               FontSize="11"
                                                               Margin="8,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Border Background="#EAF0FF"
                                                            CornerRadius="4"
                                                            Margin="8,0,0,0"
                                                            Padding="5,0">
                                                        <TextBlock Text="{Binding KindText}"
                                                                   FontSize="10"
                                                                   Foreground="#2F5FE0"/>
                                                    </Border>
                                                </StackPanel>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Preview}"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,10,0"/>
                                                    <Button Grid.Column="1" Content="复制"
                                                            Style="{StaticResource SmallButton}"
                                                            Command="{Binding CopyCommand}"
                                                            VerticalAlignment="Top"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
            </Grid>
        </DataTemplate>

        <presentation:FeaturePageTemplateSelector x:Key="FeaturePageSelector"
            FilesTemplate="{StaticResource Page.Files}"
            ScanTemplate="{StaticResource Page.Scan}"
            SearchTemplate="{StaticResource Page.Search}"
            NetdiskTemplate="{StaticResource Page.Netdisk}"
            TransferTemplate="{StaticResource Page.Transfer}"/>
        <presentation:FeaturePageKindConverter x:Key="FeaturePageKind"/>

        <!-- Shared chip template: used by the inline row and by the expanded wrap row below the name -->
        <DataTemplate DataType="{x:Type vm:SuffixChipViewModel}">
            <Button Content="{Binding Label}"
                    Command="{Binding DataContext.ToggleSuffixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Cursor="Hand"
                    Margin="4,0,0,0"
                    ToolTip="点击把该后缀加到文件名末尾；再次点击取消">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="12"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>

        <!-- Row of the account popup menu: transparent by default, light gray on hover
             (sampled from the reference menu) -->
        <Style x:Key="UserMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellMenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Flat title bar (main shell only — the settings page provides its own top strip):
             gray like the reference UI, with the sidebar toggle + brand on the left.
             The caption buttons live in their own top-most layer below so they stay
             clickable in both modes. -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{StaticResource ShellBrush}"
                Visibility="{Binding IsMainPage, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button x:Name="SidebarToggleButton"
                        Content="&#xE700;"
                        Style="{StaticResource CaptionButton}"
                        Width="40"
                        Click="OnToggleSidebarClick"
                        ToolTip="折叠 / 展开侧边栏"/>
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" Margin="6,0,0,0">
                    <TextBlock Text="◆" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="办公助理" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Sidebar: gray shell (reference UI), feature navigation, user entry & menu -->
        <Border x:Name="SidebarBorder" Grid.Row="1" Grid.Column="0"
                Background="{StaticResource ShellBrush}">
            <Grid Margin="12,14,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" CornerRadius="8" Padding="12,9" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellMenuHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellNavSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom section, pinned like a profile area: separator, user entry, menu -->
                <StackPanel Grid.Row="2">
                    <Border BorderBrush="{StaticResource ShellCardStrokeBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,8,0,0">
                        <Grid>
                        <!-- User entry (reference UI pattern): first click opens the account
                             menu, only the "设置" row inside it enters the settings page. -->
                        <Button x:Name="UserEntryButton"
                                Click="OnUserEntryClick"
                                Style="{StaticResource SidebarRowButton}"
                                ToolTip="账户与设置菜单">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="8"
                                            Background="{StaticResource AvatarBrush}">
                                        <TextBlock Text="A" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="用户A" FontSize="13"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Account menu: white card with hover rows, anchored above the entry.
                             StaysOpen=true: the menu closes itself from the window's
                             PreviewMouseDown / Deactivated handlers, which makes the
                             entry button a deterministic open/close toggle. -->
                        <Popup x:Name="UserMenuPopup"
                               PlacementTarget="{Binding ElementName=UserEntryButton}"
                               Placement="Top"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Margin="0,6,0,0">
                            <Border Background="White"
                                    BorderBrush="{StaticResource ShellCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="6"
                                    MinWidth="196">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF000000" BlurRadius="16"
                                                      ShadowDepth="2" Opacity="0.14"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,8,8,6">
                                        <Border Width="26" Height="26" CornerRadius="8"
                                                Background="{StaticResource AvatarBrush}">
                                            <TextBlock Text="A" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="用户A" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding AppVersion}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{StaticResource ShellCardStrokeBrush}"
                                            Height="1" Margin="4,2,4,6"/>

                                    <Button Style="{StaticResource UserMenuItemStyle}"
                                            Click="OnOpenSettingsClick"
                                            ToolTip="打开设置页面">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource UserMenuItemStyle}"
                                            Click="OnExitAppClick"
                                            ToolTip="退出办公助理">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77C;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="退出应用" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Work area: white content card floating on the gray shell (reference UI) -->
        <Border Grid.Row="1" Grid.Column="1"
                Margin="10,0,10,10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource ShellCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid Margin="24,20,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: current feature -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedFeature.DisplayName}"
                               FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                            Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PDF" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <!-- One-line capability note for the current feature page. -->
                    <Border Width="1" Height="15" Background="{StaticResource BorderBrushLight}"
                            Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedFeature.Tagline}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>

        <!-- Feature page: the ViewLocator picks the template declared by the feature's
             PageKind, so adding a feature never edits this visual tree. -->
        <ContentControl Grid.Row="1"
                        Grid.RowSpan="{Binding SelectedFeature.PageKind, Converter={StaticResource FeaturePageKind}, ConverterParameter=RowSpan}"
                        Content="{Binding SelectedFeature}"
                        ContentTemplateSelector="{StaticResource FeaturePageSelector}"
                        Focusable="False"
                        IsTabStop="False"/>

        <!-- File list -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorder}"
                Visibility="{Binding SelectedFeature.PageKind, Converter={StaticResource FeaturePageKind}, ConverterParameter=JobList}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="EmptyStateText"
                           Text="暂无文件 · 拖入或点击「选择文件」开始"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,30"/>

                <ListView Grid.Row="1"
                          x:Name="JobList"
                          Style="{StaticResource StableGutterListView}"
                          ItemsSource="{Binding Board.JobsView}"
                          Visibility="Collapsed"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12">
                                <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <!-- Name row: the file name takes the remaining width, quick-suffix chips
                                             sit to its right. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- file name: click to edit inline, click away/Enter saves, Esc cancels.
                                                 Hover shows a subtle pill background — the standard "this is editable" affordance. -->
                                            <Grid Grid.Column="0">
                                                <Border CornerRadius="6" Padding="4,2"
                                                        ToolTip="{Binding HeaderToolTip}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- Background must live in the Style: a local value on the element
                                                                 would outrank the hover trigger and the effect would never show. -->
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HoverSurfaceBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Cursor="Hand">
                                                        <TextBlock.InputBindings>
                                                            <MouseBinding Gesture="LeftClick" Command="{Binding BeginEditCommand}"/>
                                                        </TextBlock.InputBindings>
                                                    </TextBlock>
                                                </Border>

                                                <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" FontWeight="SemiBold"
                                                         Padding="6,2"
                                                         VerticalContentAlignment="Center"
                                                         LostFocus="OnRenameBoxLostFocus"
                                                         KeyDown="OnRenameBoxKeyDown"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                         behaviors:FocusWhenVisible.Enabled="True">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Background" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRenamable}" Value="False">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>

                                            <!-- Quick suffix chips — a dropdown component: sits right of the name; the
                                                 toggle opens an overlay with the overflow suffixes that floats above
                                                 the card, so the card layout never changes. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0"
                                                        Visibility="{Binding ChipsVisible, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding InlineChips}"
                                                          VerticalAlignment="Center"
                                                          Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <!-- Chevron toggle: always in place, flips between ▾ / ▴ to reflect state —
                                                 part of the chip family, never jumps. -->
                                            <Button Command="{Binding ToggleSuffixDropdownCommand}"
                                                    Cursor="Hand"
                                                    Margin="2,0,0,0"
                                                    ToolTip="展开或收起更多常用后缀"
                                                    Visibility="{Binding HasMoreChips, Converter={StaticResource BoolToVis}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Setter Property="Content" Value="▾"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="Padding" Value="7,4"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="12"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSuffixDropdownOpen}" Value="True">
                                                                <Setter Property="Content" Value="▴"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Seamless expansion: the overlay is pure card-white with no border, shadow
                                                 or corners — on the white card it is invisible, so the overflow chips
                                                 simply read as the same pill group continuing on a wrapped second line
                                                 (the white surface only masks the path row underneath). -->
                                            <Popup IsOpen="{Binding IsSuffixDropdownOpen}"
                                                   StaysOpen="False"
                                                   Placement="Bottom"
                                                   PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                   VerticalOffset="5"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade">
                                                <Border Background="White"
                                                        Padding="2,2,6,6"
                                                        MaxWidth="420">
                                                    <ItemsControl ItemsSource="{Binding OverflowChips}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>
                                            </StackPanel>
                                        </Grid>

                                        <!-- path row: click the path to open its folder; time at the right -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StatusLine}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="ToolTip" Value="点击打开文件所在位置"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Processing">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OutputPath}" Value="{x:Null}">
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                                <Setter Property="ToolTip" Value="还没有输出文件，完成后可点击打开"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding OutputPath}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProcessedAtText}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       ToolTip="{Binding ProcessedAt, TargetNullValue=处理完成时间}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- interrupted / cancelled scans kept their pages: one click
                                             appends the rest to this same PDF instead of a new file -->
                                        <Button Style="{StaticResource SmallButton}"
                                                Content="继续扫描"
                                                Padding="10,3"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding ShowContinueScan, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding ContinueScanCommand}"
                                                ToolTip="接续这份文档的末尾再扫几页，页面会追加到同一个 PDF"/>

                                        <!-- failed scan rows: one click re-runs the scanner instead of
                                             making the user find the scan button again -->
                                        <Button Style="{StaticResource SmallButton}"
                                                Content="重新扫描"
                                                Padding="10,3"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding RetryCommand}"
                                                ToolTip="用相同的扫描设置再扫一份"/>

                                        <!-- failed rows only: copy a full diagnostic report for bug reports -->
                                        <Button Style="{StaticResource RowCopyErrorButton}"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding ShowCopyError, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding CopyErrorCommand}"
                                                ToolTip="复制完整报错信息（含系统环境与异常堆栈）用于反馈问题"/>

                                        <!-- finished rows: expand the inline thumbnail strip (again = fold).
                                             Scan rows hide the button entirely — their strip unfolds itself. -->
                                        <Button Style="{StaticResource RowPreviewButton}"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding PreviewButtonVisibility}"
                                                Content="{Binding PreviewToggleText}"
                                                Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="在记录下方展开缩略图，点击缩略图可放大；右上角旋转即存"/>

                                        <!-- netdisk upload state: 「已上传」 stays on the record;
                                             a failed/in-flight upload keeps saying so in its own color -->
                                        <TextBlock Text="{Binding UploadChipText}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   ToolTip="{Binding UploadTip}"
                                                   Visibility="{Binding ShowUploadChip, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Upload}" Value="Uploaded">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Upload}" Value="Failed">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- finished rows: one click sends the file to the configured netdisk -->
                                        <Button Style="{StaticResource SmallButton}"
                                                Content="上传"
                                                Padding="10,3"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding ShowUploadButton, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding UploadCommand}"
                                                ToolTip="{Binding UploadTip}"/>

                                        <Button Style="{StaticResource RowDeleteButton}"
                                                Command="{Binding DataContext.Board.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="删除这条记录；已生成的文件移入回收站"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Live scan pages: thumbnails appear as each page leaves the
                                     scanner. Sized and laid out like the finished PDF strip so
                                     the hand-over reads as the same strip gaining edit controls
                                     — not as a second set of thumbnails appearing. -->
                                <Border Margin="0,12,0,0"
                                        Padding="0,12,0,0"
                                        BorderBrush="{StaticResource BorderBrushLight}"
                                        BorderThickness="0,1,0,0"
                                        Visibility="{Binding ShowLiveStrip, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="236"
                                                  Focusable="False">
                                        <ItemsControl ItemsSource="{Binding LiveThumbnails}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="92" Height="118" Margin="0,0,8,8"
                                                            Background="White"
                                                            BorderBrush="{StaticResource BorderBrushLight}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <Image Source="{Binding}" Stretch="Uniform" Margin="3"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Inline thumbnail grid, browser-style: one small tile per
                                     page on white, flowing in a wrap layout (no canvas, no
                                     dark backdrop). A tile click opens the screen-level image
                                     viewer; the rail inside stays driven by the same strip view
                                     model — one render cache, one rotation lock. The rail on the
                                     right zooms every tile (buttons step, slider drags). -->
                                <Border Margin="0,12,0,0"
                                        Padding="0,12,0,0"
                                        BorderBrush="{StaticResource BorderBrushLight}"
                                        BorderThickness="0,1,0,0"
                                        Visibility="{Binding StripOpen, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- The grid is capped at ~two tile rows and scrolls
                                             inside: a long document must not stretch the
                                             whole job list, and the zoom rail stays fixed.
                                             The wheel is forwarded to the record list once
                                             the strip itself has nothing left to show. -->
                                        <ScrollViewer Grid.Column="0"
                                                      Style="{StaticResource StableGutterScrollViewer}"
                                                      MaxHeight="{Binding Strip.ThumbAreaMaxHeight}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      PreviewMouseWheel="OnStripPreviewMouseWheel">
                                            <ItemsControl DataContext="{Binding Strip}"
                                                          ItemsSource="{Binding StripItems}"
                                                          ItemTemplateSelector="{StaticResource PdfStripItemTemplateSelector}"
                                                          Visibility="{Binding HasThumbnails, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Anchored to the area's top edge, not centered: the
                                             grid's height follows the zoom, and a centred rail
                                             would slide under the pointer while it is being
                                             used. Top anchor = the buttons never move. -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Vertical"
                                                    VerticalAlignment="Top"
                                                    Margin="10,0,4,0">
                                            <Button Command="{Binding Strip.ZoomInCommand}"
                                                    ToolTip="放大缩略图"
                                                    FontSize="11"
                                                    Padding="4,2"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                        <Setter Property="Content">
                                                            <Setter.Value>
                                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Slider Minimum="{x:Static vm:PdfPreviewViewModel.MinThumbScale}"
                                                    Maximum="{x:Static vm:PdfPreviewViewModel.MaxThumbScale}"
                                                    Value="{Binding Strip.ThumbnailScaleDraft}"
                                                    Orientation="Vertical"
                                                    Height="120"
                                                    Width="22"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,6"
                                                    TickPlacement="None"
                                                    Focusable="False"
                                                    ToolTip="拖动调整缩略图大小"/>

                                            <Button Command="{Binding Strip.ZoomOutCommand}"
                                                    ToolTip="缩小缩略图"
                                                    FontSize="11"
                                                    Padding="4,2"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                        <Setter Property="Content">
                                                            <Setter.Value>
                                                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- OCR votes on the four quarter turns and rights the
                                                 whole document in one save; scan rows run it by
                                                 themselves, this is the manual entry / retry. -->
                                            <Button Command="{Binding Strip.AutoOrientCommand}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="自动摆正：检测页面方向并整份修正"
                                                    FontSize="11"
                                                    Padding="4,2"
                                                    Margin="0,6,0,0"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                        <Setter Property="Content">
                                                            <Setter.Value>
                                                                <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- Appends a fresh scan after the LAST page. It lives
                                                 here, outside the wrap panel, on purpose: as a
                                                 trailing plus slot inside the strip it made the
                                                 last page's cell 14px wider than every other
                                                 cell, and a row that had room for the page but
                                                 not for page+14 bumped it to the next row,
                                                 leaving a cell-sized hole. -->
                                            <Button Command="{Binding Strip.AppendScanCommand}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="扫描并追加到最后一页之后"
                                                    FontSize="11"
                                                    Padding="4,2"
                                                    Margin="0,10,0,0"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                        <Setter Property="Content">
                                                            <Setter.Value>
                                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Strip status: rotating / deleting / straightening all save
                                     straight into the PDF, and the tile repaint alone is too
                                     quiet. Without this line a failure here was invisible —
                                     StatusText used to be bound only inside the big viewer. -->
                                <TextBlock Text="{Binding Strip.StatusText}"
                                           FontSize="12"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Strip.HasStatusText, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding Board.StatusText}"/>
                        <!-- Scan progress belongs to the job row; the footer echoes the same
                             action a third time, so it steps aside while a scan runs. -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- batch upload: every finished, not-yet-uploaded record of this page in one go.
                     Hidden without a configured account — the row button says why when clicked. -->
                <Button Content="上传到网盘"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0"
                        Command="{Binding UploadVisibleCommand}"
                        Visibility="{Binding CanUploadBatch, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding UploadBatchHint}"/>
                <Button Content="清空列表"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding Board.ClearCommand}"
                        ToolTip="清空本页记录；已生成的文件不会被删除"/>
            </StackPanel>
        </Grid>
            </Grid>
        </Border>

        <!-- Settings second-level page: covers the entire window (title bar included) —
             the app *switches page*, it does not open a new window. Opaque by design:
             its left column is the gray shell, its right pane is white. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <app:SettingsPage DataContext="{Binding SettingsPage}"/>
        </Grid>

        <!-- Caption buttons ride in the top-most layer so minimize/maximize/close keep
             working over both the main shell and the settings page. -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <!-- Background-downloaded update: the icon reports the whole journey — pulsing while
                 downloading (the percentage lives in the tooltip), a red dot once the package is
                 verified, a warning glyph when the attempt failed (click = retry). -->
            <Button x:Name="UpdateReadyButton"
                    Style="{StaticResource CaptionButton}"
                    Command="{Binding InstallUpdateCommand}"
                    Visibility="{Binding UpdateReady.HasUpdate, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding UpdateReady.Hint}">
                <Grid Width="18" Height="18">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE896;"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateReady.State}" Value="Downloading">
                                        <Setter Property="Text" Value="&#xE895;"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.35" To="1"
                                                                     Duration="0:0:0.7"
                                                                     AutoReverse="True"
                                                                     RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UpdateReady.State}" Value="Failed">
                                        <Setter Property="Text" Value="&#xE783;"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Width="6" Height="6" CornerRadius="3"
                            Background="{StaticResource DangerBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateReady.State}" Value="Ready">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Button>
            <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}"
                    Click="OnMinimizeClick" ToolTip="最小化"/>
            <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}"
                    Click="OnMaximizeClick" ToolTip="最大化"/>
            <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}"
                    Click="OnCloseClick" ToolTip="关闭"/>
        </StackPanel>
    </Grid>
</Window>
