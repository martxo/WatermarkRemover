<Window x:Class="WatermarkRemover.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PageBrush}">

    <!-- Palette and shared styles (SectionLabel/SmallButton/InputBox/PrimaryButton)
         come from Themes/ merged in App.xaml. All state lives in SettingsViewModel. -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>

            <!-- Output suffix -->
            <TextBlock Text="生成文件名后缀" Style="{StaticResource SectionLabel}"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SuffixBox" Style="{StaticResource InputBox}"
                         Text="{Binding Settings.OutputSuffix, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="OnSuffixTextChanged"/>
            </Grid>
            <TextBlock Text="{Binding SuffixPreviewText}"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,-12,0,18"/>

            <!-- Output location -->
            <TextBlock Text="输出位置" Style="{StaticResource SectionLabel}"/>
            <StackPanel Margin="0,0,0,8">
                <RadioButton x:Name="SameDirRadio" Content="与源文件相同目录" GroupName="OutputMode"
                             FontSize="13" Margin="0,0,0,8" Checked="OnOutputModeChanged"/>
                <RadioButton x:Name="CustomDirRadio" Content="指定目录" GroupName="OutputMode"
                             FontSize="13" Margin="0,0,0,8" Checked="OnOutputModeChanged"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirBox" Grid.Column="0" Style="{StaticResource InputBox}"
                             Text="{Binding Settings.OutputDirectory}" IsEnabled="False"/>
                    <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0"
                            FontSize="12" Padding="12,8" Click="OnBrowseDirectory"
                            Style="{StaticResource SmallButton}"/>
                </Grid>
            </StackPanel>

            <!-- Quick suffixes -->
            <TextBlock Text="常用文件名后缀" Style="{StaticResource SectionLabel}" Margin="0,10,0,4"/>
            <TextBlock Text="处理完成后，点击文件名右侧的标签可把后缀快速加到文件名末尾，再点一次取消。标签顺序与任务列表中一致，可用上移、下移调整。"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Border BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,18">
                <StackPanel>
                    <ListBox x:Name="SuffixList" Height="120" FontSize="13" BorderThickness="0"
                             ItemsSource="{Binding QuickSuffixes}"
                             SelectedIndex="{Binding SelectedSuffixIndex, Mode=TwoWay}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                 Text="{Binding NewSuffixText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,6" KeyDown="OnSuffixBoxKeyDown"/>
                        <Button Grid.Column="1" Content="添加" Style="{StaticResource SmallButton}"
                                Margin="8,0,0,0" Command="{Binding AddSuffixCommand}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="上移" Style="{StaticResource SmallButton}" Command="{Binding MoveUpCommand}"/>
                        <Button Content="下移" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding MoveDownCommand}"/>
                        <Button Content="改为输入内容" Style="{StaticResource SmallButton}" Margin="16,0,0,0" Command="{Binding UpdateSuffixCommand}"/>
                        <Button Content="删除" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding DeleteSuffixCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Smart naming -->
            <TextBlock Text="自动命名" Style="{StaticResource SectionLabel}" Margin="0,10,0,8"/>
            <CheckBox Content="按文件内容自动命名去水印结果（如 林孝明执照）"
                      IsChecked="{Binding Settings.AutoNameByContent}"
                      FontSize="13" Margin="0,0,0,4"/>
            <TextBlock Text="识别文件类型并提取客户姓名，生成「姓名＋类型」文件名；识别不出来时沿用上面的后缀规则。"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="22,0,0,18"/>

            <!-- Advanced -->
            <TextBlock Text="其他" Style="{StaticResource SectionLabel}" Margin="0,10,0,8"/>
            <CheckBox Content="同时移除水印附带的链接注释"
                      IsChecked="{Binding Settings.RemoveLinkedAnnotations}"
                      FontSize="13" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="同时处理文件数：" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ComboBox Width="80" FontSize="13" Padding="8,6"
                          SelectedIndex="{Binding ConcurrencyIndex}"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                </ComboBox>
            </StackPanel>

            <!-- Updates -->
            <TextBlock Text="软件更新" Style="{StaticResource SectionLabel}" Margin="0,10,0,8"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <CheckBox Content="启动时自动检查更新"
                              IsChecked="{Binding Settings.CheckUpdatesOnStartup}"
                              FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
                <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新"
                        VerticalAlignment="Center" FontSize="12" Padding="14,8"
                        Style="{StaticResource SmallButton}" Click="OnCheckUpdate"/>
            </Grid>

            <!-- Log & diagnostics -->
            <TextBlock Text="日志与排障" Style="{StaticResource SectionLabel}" Margin="0,10,0,4"/>
            <TextBlock Text="查看最近一段时间的执行记录，可导出后发回用于分析问题（如自动命名未生效）。日志仅保存在本机，保留 7 天。"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="时间范围：" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ComboBox Width="110" FontSize="13" Padding="8,6"
                          SelectedIndex="{Binding LogRangeIndex}"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="最近 1 小时"/>
                    <ComboBoxItem Content="最近 24 小时"/>
                    <ComboBoxItem Content="最近 7 天"/>
                </ComboBox>
                <TextBlock Text="{Binding LogStatusText}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     Height="150" TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Text="{Binding LogPreviewText, Mode=OneWay}"
                     Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushLight}"
                     Padding="8,6" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Button Content="刷新" Style="{StaticResource SmallButton}" Command="{Binding RefreshLogCommand}"/>
                <Button Content="复制日志" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding CopyLogCommand}"/>
                <Button Content="导出日志文件…" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding ExportLogCommand}"/>
                <Button Content="打开日志文件夹" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding OpenLogFolderCommand}"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Content="取消" HorizontalAlignment="Left"
                    Style="{StaticResource GhostButton}" Padding="18,9" Click="OnCancel"/>
            <Button Content="保存" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                    Padding="20,9" Click="OnSave"/>
        </Grid>
    </Grid>
</Window>
