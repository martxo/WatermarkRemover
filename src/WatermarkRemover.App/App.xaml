<Application x:Class="WatermarkRemover.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette first: control styles reference its brushes -->
                <ResourceDictionary Source="Themes/Palette.xaml"/>
                <!-- Trigger-zone cloud (runtime hover indicator + settings mock), shared shape -->
                <ResourceDictionary Source="Themes/TriggerZone.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
