<Window x:Class="WatermarkRemover.App.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="问题反馈"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="问题反馈" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- 从某条识别记录进来时显示关联的操作摘要；全局入口隐藏。 -->
        <TextBlock x:Name="ContextText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap"
                   MaxHeight="40" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>

        <TextBlock Grid.Row="2" Text="问题描述" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
        <TextBox x:Name="DescriptionBox" Grid.Row="3" MinHeight="90"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" Padding="10,8" FontSize="13"/>

        <TextBlock Grid.Row="4" Text="联系方式（选填，方便我们回复你）" Style="{StaticResource SectionLabel}"
                   Margin="0,12,0,0"/>
        <TextBox x:Name="ContactBox" Grid.Row="5"
                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" Padding="10,8" FontSize="13"/>

        <TextBlock Grid.Row="6" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="将附带：软件版本、系统信息、该次操作的日志和识别记录。不会上传你的文档内容。反馈先存本机，再上传阿里云盘私有目录。"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="260"/>
            <Button Content="取消" Style="{StaticResource SmallButton}" Click="OnCancelClick" Margin="0,0,8,0"/>
            <Button x:Name="SubmitButton" Content="提交" Style="{StaticResource SmallButton}"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    Click="OnSubmitClick" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
