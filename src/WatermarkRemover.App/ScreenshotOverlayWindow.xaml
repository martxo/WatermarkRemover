<Window x:Class="WatermarkRemover.App.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        Background="#FF000000"
        Cursor="Cross"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseEnter="OnMouseEnter">
    <Window.Resources>
        <!-- Dark floating toolbar: the overlay itself is the only surface, so these controls
             are deliberately self-contained instead of reusing the light app palette. -->
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#FF3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2F6FDD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Canvas x:Name="RootCanvas" Background="#FF000000" ClipToBounds="True" Focusable="True">
        <!-- The captured pixels for this monitor (positioned/sized in code so one bitmap
             pixel always maps to one physical pixel). -->
        <Image x:Name="ScreenImage" Stretch="Fill" IsHitTestVisible="False"/>

        <!-- Dimmed area outside the selection (four bands, also laid out in code). -->
        <Rectangle x:Name="DimTop" Fill="#A6000000" IsHitTestVisible="False"/>
        <Rectangle x:Name="DimBottom" Fill="#A6000000" IsHitTestVisible="False"/>
        <Rectangle x:Name="DimLeft" Fill="#A6000000" IsHitTestVisible="False"/>
        <Rectangle x:Name="DimRight" Fill="#A6000000" IsHitTestVisible="False"/>

        <!-- WYSIWYG preview: the same composer output the PNG will contain, including mosaics
             and text. Live drag shapes are drawn above it. -->
        <Image x:Name="PreviewImage" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>

        <Canvas x:Name="ShapeLayer" IsHitTestVisible="False"/>

        <Rectangle x:Name="SelectionBorder" Stroke="#FF3B82F6" StrokeThickness="1.5"
                   IsHitTestVisible="False" Visibility="Collapsed"/>

        <Canvas x:Name="HandleLayer" IsHitTestVisible="False">
            <Rectangle x:Name="HandleTopLeft" Width="8" Height="8" Fill="White" Stroke="#FF3B82F6" StrokeThickness="1" Visibility="Collapsed"/>
            <Rectangle x:Name="HandleTop" Width="8" Height="8" Fill="White" Stroke="#FF3B82F6" StrokeThickness="1" Visibility="Collapsed"/>
            <Rectangle x:Name="HandleTopRight" Width="8" Height="8" Fill="White" Stroke="#FF3B82F6" StrokeThickness="1" Visibility="Collapsed"/>
            <Rectangle x:Name="HandleLeft" Width="8" Height="8" Fill="White" Stroke="#FF3B82F6" StrokeThickness="1" Visibility="Collapsed"/>
            <Rectangle x:Name="HandleRight" Width="8" Height="8" Fill="White" Stroke="#FF3B82F6" StrokeThickness="1" Visibility="Collapsed"/>
            <Rectangle x:Name="HandleBottomLeft" Width="8" Height="8" Fill="White" Stroke="#FF3B82F6" StrokeThickness="1" Visibility="Collapsed"/>
            <Rectangle x:Name="HandleBottom" Width="8" Height="8" Fill="White" Stroke="#FF3B82F6" StrokeThickness="1" Visibility="Collapsed"/>
            <Rectangle x:Name="HandleBottomRight" Width="8" Height="8" Fill="White" Stroke="#FF3B82F6" StrokeThickness="1" Visibility="Collapsed"/>
        </Canvas>

        <Border x:Name="SizeLabel" Background="#CC1E1E1E" CornerRadius="3" Padding="6,2"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="SizeText" Foreground="#FFEDEDED" FontSize="11"/>
        </Border>

        <!-- Crosshair + magnifier while the user is still choosing the region. -->
        <Canvas x:Name="HoverLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <Line x:Name="CrossVertical" Stroke="#99FFFFFF" StrokeThickness="1"/>
            <Line x:Name="CrossHorizontal" Stroke="#99FFFFFF" StrokeThickness="1"/>
            <Border x:Name="Magnifier" Width="132" Height="132" Background="#FF1E1E1E"
                    BorderBrush="#FF3B82F6" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Image x:Name="MagnifierImage" Stretch="Fill" Margin="2"/>
                    <Line X1="0" X2="132" Y1="66" Y2="66" Stroke="#80FF3B30" StrokeThickness="1"/>
                    <Line X1="66" X2="66" Y1="0" Y2="132" Stroke="#80FF3B30" StrokeThickness="1"/>
                </Grid>
            </Border>
        </Canvas>

        <TextBox x:Name="TextEditor" Width="260" Height="30" Visibility="Collapsed"
                 Background="#E6FFFFFF" Foreground="#FFE53935" FontSize="16"
                 BorderBrush="#FF3B82F6" BorderThickness="1" Padding="4,2"
                 VerticalContentAlignment="Center"
                 KeyDown="OnTextEditorKeyDown" LostFocus="OnTextEditorLostFocus"/>

        <!-- Floating annotation toolbar, anchored under (or above) the selection. -->
        <Border x:Name="ToolbarHost" Background="#F21E1E1E" CornerRadius="8"
                BorderBrush="#33FFFFFF" BorderThickness="1" Padding="5,4"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="RectTool" Content="矩形" Style="{StaticResource ToolToggle}"
                              ToolTip="拖拽画矩形框"/>
                <ToggleButton x:Name="ArrowTool" Content="箭头" Style="{StaticResource ToolToggle}"
                              ToolTip="拖拽画箭头"/>
                <ToggleButton x:Name="PenTool" Content="画笔" Style="{StaticResource ToolToggle}"
                              ToolTip="按住拖动自由绘制"/>
                <ToggleButton x:Name="TextTool" Content="文字" Style="{StaticResource ToolToggle}"
                              ToolTip="点击选区后输入文字，回车确认"/>
                <ToggleButton x:Name="MosaicTool" Content="马赛克" Style="{StaticResource ToolToggle}"
                              ToolTip="拖拽涂抹遮挡敏感内容"/>

                <Rectangle Width="1" Fill="#33FFFFFF" Margin="6,2"/>

                <Button x:Name="UndoButton" Content="撤销" Style="{StaticResource ToolButton}"
                        ToolTip="撤销上一步标注（Ctrl+Z）"/>
                <Button x:Name="ClearButton" Content="清空" Style="{StaticResource ToolButton}"
                        ToolTip="清除全部标注"/>
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource ToolButton}"
                        ToolTip="取消本次截图（Esc）"/>
                <Button x:Name="ConfirmButton" Content="复制并保存" Style="{StaticResource ToolPrimaryButton}"
                        ToolTip="复制到剪贴板并保存 PNG（Enter / Ctrl+C）"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
