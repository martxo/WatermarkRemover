<Window x:Class="WatermarkRemover.App.CloudUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云更新（阿里云盘）"
        Width="840" Height="740"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBrush}">

    <Window.Resources>
        <Style x:Key="InsetCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ShellInsetCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellInsetCardStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="RowCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 当前版本 / 账号 / 操作 -->
        <Border Grid.Row="0" Style="{StaticResource InsetCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="阿里云盘增量更新" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource RowCaption}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding AccountText}" Style="{StaticResource RowCaption}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource RowCaption}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="检查云更新" Style="{StaticResource SmallButton}" Padding="14,7"
                            Command="{Binding CheckCommand}"/>
                    <Button Content="{Binding ApplyButtonText}" Style="{StaticResource SmallButton}" Padding="14,7"
                            Margin="0,6,0,0" Command="{Binding ApplyCommand}"/>
                    <Button Content="登录阿里云盘" Style="{StaticResource SmallButton}" Padding="14,7"
                            Margin="0,6,0,0"
                            Visibility="{Binding NeedsLogin, Converter={StaticResource BoolToVis}}"
                            Command="{Binding OpenLoginCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 进度 -->
        <Border Grid.Row="1" Style="{StaticResource InsetCard}" Margin="0,10,0,0">
            <StackPanel>
                <ProgressBar Height="8" Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent}"
                             IsIndeterminate="{Binding ProgressIndeterminate}"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource BorderBrushLight}"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource RowCaption}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- 本次更新明细 -->
        <Border Grid.Row="2" Style="{StaticResource InsetCard}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="本次变更明细" Style="{StaticResource RowTitle}"/>
                <TextBox Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="11"
                         Height="92" Margin="0,8,0,0"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource ShellInsetCardStrokeBrush}"
                         Padding="8,6"/>
            </StackPanel>
        </Border>

        <!-- 版本记录 + 回滚 -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="云端保留的版本（最近 5 个，可直接回滚）" Style="{StaticResource SectionTitle}"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InsetCard}" Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource RowTitle}"/>
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4"
                                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="当前版本" FontSize="10"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource RowCaption}" Margin="0,4,0,0"/>
                                        <TextBlock Style="{StaticResource RowCaption}" Margin="0,2,0,0">
                                            <Run Text="{Binding DateText, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding ChangeText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="回滚到此版本" Style="{StaticResource SmallButton}"
                                            Padding="12,6" VerticalAlignment="Center"
                                            Command="{Binding RollbackCommand}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="本机更新记录" Style="{StaticResource SectionTitle}"/>
            <Border Grid.Row="3" Style="{StaticResource InsetCard}" Padding="14,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding At, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding DirectionText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding VersionText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding ChangeText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
