<Window x:Class="WatermarkRemover.App.ScreenshotShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="最近截图"
        Width="1200" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- The rope fades out at both screen edges, like Tendedero's #rope mask. -->
        <LinearGradientBrush x:Key="RopeFade" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#FF000000" Offset="0.08"/>
            <GradientStop Color="#FF000000" Offset="0.92"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>

        <!-- .card::after — a 1px edge that is bright on top and fades downwards. -->
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8CFFFFFF" Offset="0"/>
            <GradientStop Color="#33FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ShelfTipStyle" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Foreground" Value="#FFF3F3F5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#E627272A" CornerRadius="8" Padding="9,5" Margin="0,0,0,6">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF000000" BlurRadius="14" ShadowDepth="3"
                                                  Opacity="0.32" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          One peg, straight from js/line.js: a 9x26 aluminium clip with a punch slot,
          then a glass photo card (4px padding, radius 16, hairline edge, soft double shadow).
          The root swings around its top centre, the way .swing does.
        -->
        <DataTemplate x:Key="PhotoTemplate">
            <Grid x:Name="SwingRoot" Width="150" RenderTransformOrigin="0.5,0">
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="Clip" Width="9" Height="26" CornerRadius="3.5"
                            HorizontalAlignment="Center" Margin="0,0,0,-12" Panel.ZIndex="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFB3B3B3" Offset="0"/>
                                <GradientStop Color="#FFEDEDED" Offset="0.35"/>
                                <GradientStop Color="#FFD1D1D1" Offset="0.65"/>
                                <GradientStop Color="#FF9E9E9E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF000000" BlurRadius="2.5" ShadowDepth="1.5"
                                              Opacity="0.30" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <!-- .clip inset hairline -->
                            <Border CornerRadius="3" BorderThickness="0.6" BorderBrush="#BFFFFFFF"/>
                            <!-- .clip::after, the little slot the rope passes through -->
                            <Border Width="5" Height="1.4" CornerRadius="1" Background="#52000000"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="2,8.5,0,0"/>
                        </Grid>
                    </Border>

                    <Border x:Name="PhotoCard" Padding="4" CornerRadius="16"
                            Background="#B8F7F7F9"
                            BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"
                            RenderTransformOrigin="0.5,0"
                            Cursor="Hand"
                            ToolTipService.InitialShowDelay="650"
                            ToolTipService.ShowDuration="6000"
                            Loaded="OnPhotoLoaded"
                            MouseEnter="OnPhotoMouseEnter"
                            MouseLeave="OnPhotoMouseLeave"
                            MouseLeftButtonDown="OnPhotoMouseDown"
                            MouseMove="OnPhotoMouseMove"
                            MouseLeftButtonUp="OnPhotoMouseUp">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF000000" BlurRadius="18" ShadowDepth="4"
                                              Opacity="0.16" Direction="270"/>
                        </Border.Effect>
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource ShelfTipStyle}"
                                     Content="单击复制 · 长按标注 · 拖到其他程序 · 双击查看"/>
                        </Border.ToolTip>
                        <Grid>
                            <Image x:Name="PhotoImage" Source="{Binding Thumbnail}" Stretch="Uniform"
                                   MaxWidth="136" MaxHeight="104"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- .photo-edge: inset hairline so the photo sits in the glass -->
                            <Border CornerRadius="12" BorderThickness="0.75" BorderBrush="#2EFFFFFF"
                                    IsHitTestVisible="False"/>

                            <!-- .cross: glass capsule in the top-left, revealed on hover -->
                            <Border x:Name="RemoveChip" Width="20" Height="20" CornerRadius="10"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="3,3,0,0"
                                    Opacity="0" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="OnRemovePreviewMouseDown"
                                    MouseLeftButtonUp="OnRemoveClick"
                                    ToolTipService.InitialShowDelay="650">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CrossScale" ScaleX="0.6" ScaleY="0.6"/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#00FAFAFC"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E3FAFAFC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ToolTip>
                                    <ToolTip Style="{StaticResource ShelfTipStyle}"
                                             Content="从晾衣绳取下（文件仍留在截图记录）"/>
                                </Border.ToolTip>
                                <Path Data="M2,2 L8,8 M8,2 L2,8"
                                      Stroke="#FF2C2C2E" StrokeThickness="1.55"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="8" Height="8" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- .copied: capsule hanging just below the card, outside the clipping border -->
                <Border x:Name="CopiedBadge" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,-16" Padding="9,3" CornerRadius="999"
                        Background="#D9FAFAFC" BorderBrush="#4DFFFFFF" BorderThickness="1"
                        Opacity="0" IsHitTestVisible="False" Panel.ZIndex="3">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF000000" BlurRadius="12" ShadowDepth="3"
                                          Opacity="0.22" Direction="270"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="CopiedShift" Y="4"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2.5,6.5 L5,9 L9.5,3"
                              Stroke="#FF16A34A" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="12" Height="12" Stretch="None"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="已复制" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF2B2B2E" Margin="5,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Canvas x:Name="RootCanvas" ClipToBounds="True">
        <Path x:Name="RopeShadow" Stroke="#38000000" StrokeThickness="1.4"
              OpacityMask="{StaticResource RopeFade}"/>
        <Path x:Name="Rope" Stroke="#FF8C8C8C" StrokeThickness="1.2"
              OpacityMask="{StaticResource RopeFade}"/>
        <Path x:Name="RopeHighlight" Stroke="#73FFFFFF" StrokeThickness="0.4"
              OpacityMask="{StaticResource RopeFade}"/>

        <Canvas x:Name="ItemsLayer"/>

        <TextBlock x:Name="EmptyHint"
                   Text="截图会挂在这里 · Ctrl+Alt+A 截一张"
                   Foreground="#B8FFFFFF" FontSize="12"
                   FontWeight="Medium"
                   Visibility="Collapsed">
            <TextBlock.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="3" ShadowDepth="0" Opacity="0.45"/>
            </TextBlock.Effect>
        </TextBlock>
    </Canvas>
</Window>
