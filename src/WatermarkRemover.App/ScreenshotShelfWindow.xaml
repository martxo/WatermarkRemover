<Window x:Class="WatermarkRemover.App.ScreenshotShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="最近截图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="ShelfButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShelfChip" TargetType="Button">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F21E1E1E" CornerRadius="14" BorderBrush="#33FFFFFF" BorderThickness="1"
            Padding="16,12" MaxWidth="1040">
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" BlurRadius="24" ShadowDepth="4" Opacity="0.38"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="最近截图" Foreground="#FFEDEDED" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CountText" Foreground="#8AFFFFFF" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="单击缩略图复制 · 拖到其他程序发送 · 双击打开 · 贴图可置顶"
                               Foreground="#8AFFFFFF" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="打开截图文件夹" Style="{StaticResource ShelfButton}"
                            Click="OnOpenFolderClick"/>
                    <Button Content="关闭" Style="{StaticResource ShelfButton}" Margin="6,0,0,0"
                            Click="OnCloseClick"/>
                </StackPanel>
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl x:Name="ItemsHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="146" Margin="0,0,10,0" Background="#14FFFFFF" CornerRadius="8"
                                    Padding="6">
                                <StackPanel>
                                    <Border Height="72" CornerRadius="5" Background="#FF2B2B2B"
                                            Cursor="Hand"
                                            ToolTip="单击复制图片，拖到其他程序发送，双击打开"
                                            MouseLeftButtonDown="OnThumbnailMouseDown"
                                            MouseMove="OnThumbnailMouseMove"
                                            MouseLeftButtonUp="OnThumbnailMouseUp">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#FFEDEDED"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Margin="0,7,0,0"/>
                                    <TextBlock Text="{Binding ProcessedAtText}" Foreground="#8AFFFFFF"
                                               FontSize="10" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="复制" Style="{StaticResource ShelfChip}"
                                                Command="{Binding CopyImageCommand}"/>
                                        <Button Content="贴图" Style="{StaticResource ShelfChip}"
                                                Command="{Binding PinImageCommand}"/>
                                        <Button Content="文字" Style="{StaticResource ShelfChip}"
                                                Command="{Binding RecognizeTextCommand}"/>
                                        <Button Content="打开" Style="{StaticResource ShelfChip}"
                                                Command="{Binding OpenImageCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText"
                       Text="还没有截图 · 按 Ctrl+Alt+A 截一张，它会挂在这条「晾衣绳」上"
                       Foreground="#8AFFFFFF" FontSize="12" Margin="0,4"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="StatusText" Foreground="#FF9AD8FF" FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
