<Window x:Class="WatermarkRemover.App.ScreenshotOcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图文字识别"
        Width="640" Height="480"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#FFFFFFFF"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="截图文字" FontSize="16" FontWeight="SemiBold" Foreground="#FF1F1F1F"/>
            <TextBlock x:Name="EngineText" FontSize="11" Foreground="#FF666666" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FFF7F7F7" CornerRadius="6"
                BorderBrush="#FFE2E2E2" BorderThickness="1">
            <TextBox x:Name="ResultBox" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="Transparent"
                     FontSize="13" Padding="10" Foreground="#FF222222"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" FontSize="11" Foreground="#FF666666"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制文字" Padding="14,6" Margin="0,0,8,0"
                        Click="OnCopyClick"/>
                <Button Content="关闭" Padding="14,6" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
