<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WatermarkRemover.Indexer</AssemblyName>
    <RootNamespace>WatermarkRemover.Indexer</RootNamespace>
    <!-- The host carries its OWN version, independent of the app: NeedsUpdate must fire only when
         the engine itself changed, not on every app release. Bump this when the indexing host
         (not the app) changes. -->
    <Version>1.16.23</Version>
    <!-- No console window: this runs as a hidden logon task and as the elevated installer.
         Hosted by the app as a sidecar beside WatermarkRemover.exe. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WatermarkRemover.Index\WatermarkRemover.Index.csproj" />
  </ItemGroup>

</Project>
