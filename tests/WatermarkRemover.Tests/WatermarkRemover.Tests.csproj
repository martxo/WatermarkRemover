<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the App project's TFM so the WPF assembly can be referenced and its
         view models / services exercised with fakes. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- WPF implicit usings exclude System.IO; the tests rely on it heavily. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WatermarkRemover.Core\WatermarkRemover.Core.csproj" />
    <!-- File index engine (快速搜索): store / query / USN parsing / snapshot. -->
    <ProjectReference Include="..\..\src\WatermarkRemover.Index\WatermarkRemover.Index.csproj" />
    <!-- Netdisk feature (网盘): provider extension point / persistence / Aliyun token flow. -->
    <ProjectReference Include="..\..\src\WatermarkRemover.Netdisk\WatermarkRemover.Netdisk.csproj" />
    <ProjectReference Include="..\..\src\WatermarkRemover.Pdf\WatermarkRemover.Pdf.csproj" />
    <ProjectReference Include="..\..\src\WatermarkRemover.App\WatermarkRemover.App.csproj" />
    <!-- Scan feature (扫描): naming / output directory / page order / PDF assembly. -->
    <ProjectReference Include="..\..\src\WatermarkRemover.Scan.Core\WatermarkRemover.Scan.Core.csproj" />
    <ProjectReference Include="..\..\src\WatermarkRemover.Scan.Engine\WatermarkRemover.Scan.Engine.csproj" />
    <ProjectReference Include="..\..\src\WatermarkRemover.Scan.Pdf\WatermarkRemover.Scan.Pdf.csproj" />
  </ItemGroup>

</Project>
